                          <span style={{ display: "inline-flex", alignItems: "center", padding: "2px 8px", borderRadius: 999, background: statusBg(r.new_value), color: statusColor(r.new_value), fontWeight: 700, fontSize: 11 }}>{r.new_value || "(kosong)"}</span>
