          <ArPiutangInput t={t} readOnly={readOnly} dseCode={dse.dse_code} dseName={dse.ds_name} mc={dse.mc} branch={dse.branch} entryDate={entryDate} arMonth={arMonth} profile={profile} outstanding={outstanding} onApplyLedger={handleApplyLedger} onConfirmSave={() => onSave(dse.dse_code)} saving={saving} />
