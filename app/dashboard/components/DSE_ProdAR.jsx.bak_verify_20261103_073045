              <div style={{ display: "flex", gap: 10, width: isCardView ? "100%" : "auto" }}>
                <button onClick={() => fetchRiwayat(page, search)} title="Refresh" style={{ width: 38, height: 38, borderRadius: 9, border: `1px solid ${t.inputBd}`, background: t.inputBg, color: t.mid, cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center", flexShrink: 0 }}>
                  <RefreshCw size={14} className={fetching ? "spin" : ""} />
                </button>
                <button onClick={handleExport} disabled={exportLoading} style={{ display: "flex", alignItems: "center", justifyContent: "center", gap: 7, height: 38, padding: "0 14px", borderRadius: 9, border: `1px solid ${t.tealBd}`, background: t.tealBg, color: t.teal, fontSize: 13, fontWeight: 700, cursor: "pointer", opacity: exportLoading ? 0.6 : 1, flexShrink: 0, flex: isCardView ? 1 : "none" }}>
                  {exportLoading ? <Loader2 size={14} className="spin" /> : <FileDown size={14} />}
                  Export
                </button>
                <button onClick={openCetakBulk} disabled={bulkLoading} title="Cetak laporan tunggakan semua DSE (akhir bulan terpilih di tab AR DSE)" style={{ display: "flex", alignItems: "center", justifyContent: "center", gap: 7, height: 38, padding: "0 14px", borderRadius: 9, border: `1px solid ${t.inputBd}`, background: t.inputBg, color: t.mid, fontSize: 13, fontWeight: 700, cursor: "pointer", opacity: bulkLoading ? 0.6 : 1, flexShrink: 0, flex: isCardView ? 1 : "none" }}>
                  {bulkLoading ? <Loader2 size={14} className="spin" /> : <Printer size={14} />}
                  Cetak Tunggakan
                </button>
              </div>
            </div>

            <div style={{ padding: "6px 16px", fontSize: 12, color: t.mid, borderBottom: `1px solid ${t.line}` }}>
              {total.toLocaleString("id-ID")} baris
            </div>

            {isCardView ? (
              <div style={{ display: "flex", flexDirection: "column", gap: 10, padding: 14 }}>
                {fetching ? (
                  <LoadingBlock t={t} label="Memuat data…" minHeight={140} />
                ) : rows.length === 0 ? (
                  <div style={{ padding: 28, textAlign: "center", color: t.mid }}>Belum ada data.</div>
                ) : rows.map((r) => (
                  <div key={r.id} style={{ borderRadius: 12, border: `1px solid ${t.line}`, background: t.sub, padding: 14 }}>
                    <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", marginBottom: 8, gap: 8 }}>
                      <div style={{ minWidth: 0 }}>
                        <div style={{ fontSize: 13.5, fontWeight: 800 }}>
                          {r.dse_code}
                        </div>
                        <div style={{ fontSize: 11.5, color: t.mid }}>{r.mc || "-"} {r.branch ? `· ${r.branch}` : ""}</div>
                      </div>
                      <div style={{ fontSize: 11.5, color: t.mid, whiteSpace: "nowrap" }}>{r.tanggal}</div>
                    </div>
                    <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: 8, fontSize: 12 }}>
                      <div><div style={{ color: t.lo, fontSize: 10.5 }}>SP</div><div style={{ fontWeight: 700 }}>{fmtID(r.qty_sp)}</div><div style={{ color: t.mid }}>Rp {fmtID(r.nilai_sp)}</div></div>
                      <div><div style={{ color: t.lo, fontSize: 10.5 }}>SALDO</div><div style={{ fontWeight: 700 }}>{fmtID(r.qty_saldo)}</div><div style={{ color: t.mid }}>Rp {fmtID(r.nilai_saldo)}</div></div>
                      <div><div style={{ color: t.lo, fontSize: 10.5 }}>VOUCHER</div><div style={{ fontWeight: 700 }}>{fmtID(r.qty_voucher)}</div><div style={{ color: t.mid }}>Rp {fmtID(r.nilai_voucher)}</div></div>
                    </div>
                    <div style={{ marginTop: 8, paddingTop: 8, borderTop: `1px solid ${t.line}`, display: "flex", justifyContent: "space-between", gap: 8 }}>
                      <span style={{ fontSize: 11.5, color: t.mid }}>Bayar AR</span>
                      <span style={{ fontSize: 12, fontWeight: 700, color: t.teal }}>Rp {fmtID(r.ar_bayar || 0)}</span>
                    </div>
                    <div style={{ display: "flex", justifyContent: "space-between" }}>
                      <span style={{ fontSize: 11.5, color: t.mid }}>Sisa AR / Piutang</span>
                      <span style={{ fontSize: 12.5, fontWeight: 800, color: fRaw(r.ar_piutang) > 0 ? t.amber : t.hi }}>Rp {fmtID(r.ar_piutang)}</span>
                    </div>
                    {r.catatan && <div style={{ marginTop: 6, fontSize: 11.5, color: t.mid, fontStyle: "italic" }}>{r.catatan}</div>}
                    {r.updated_at && <div style={{ marginTop: 4, fontSize: 10.5, color: t.lo, display: "flex", alignItems: "center", gap: 4 }}><Clock size={9} />Diperbarui {fmtTime(r.updated_at)}</div>}
                  </div>
                ))}
              </div>
            ) : (
              <div style={{ overflowX: "auto" }}>
                <table style={{ width: "100%", borderCollapse: "collapse", fontSize: 12.5 }}>
                  <thead>
                    <tr style={{ background: t.sub }}>
                      {["Tanggal", "Kode DSE", "MC", "Branch", "Qty SP", "Nilai SP", "Qty Saldo", "Nilai Saldo", "Qty Voucher", "Nilai Voucher", "AR/Piutang", "Catatan"].map((h, i) => (
                        <th key={i} style={{ textAlign: i >= 4 ? "right" : "left", padding: "9px 12px", color: t.mid, fontWeight: 700, whiteSpace: "nowrap", borderBottom: `1px solid ${t.line}` }}>{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {fetching ? (
                      <tr><td colSpan={11} style={{ padding: 28, textAlign: "center", color: t.mid }}><Loader2 size={16} className="spin" /></td></tr>
                    ) : rows.length === 0 ? (
                      <tr><td colSpan={11} style={{ padding: 28, textAlign: "center", color: t.mid }}>Belum ada data.</td></tr>
                    ) : rows.map((r) => (
                      <tr key={r.id} style={{ borderBottom: `1px solid ${t.line}` }}>
                        <td style={{ padding: "8px 12px", whiteSpace: "nowrap" }}>{r.tanggal}</td>
                        <td style={{ padding: "8px 12px", whiteSpace: "nowrap", fontWeight: 700 }}>{r.dse_code}</td>
                        <td style={{ padding: "8px 12px", whiteSpace: "nowrap" }}>{r.mc || "-"}</td>
                        <td style={{ padding: "8px 12px", whiteSpace: "nowrap" }}>{r.branch || "-"}</td>
                        <td style={{ padding: "8px 12px", textAlign: "right" }}>{fmtID(r.qty_sp)}</td>
                        <td style={{ padding: "8px 12px", textAlign: "right" }}>{fmtID(r.nilai_sp)}</td>
                        <td style={{ padding: "8px 12px", textAlign: "right" }}>{fmtID(r.qty_saldo)}</td>
                        <td style={{ padding: "8px 12px", textAlign: "right" }}>{fmtID(r.nilai_saldo)}</td>
                        <td style={{ padding: "8px 12px", textAlign: "right" }}>{fmtID(r.qty_voucher)}</td>
                        <td style={{ padding: "8px 12px", textAlign: "right" }}>{fmtID(r.nilai_voucher)}</td>
                        <td style={{ padding: "8px 12px", textAlign: "right", fontWeight: 700, color: fRaw(r.ar_piutang) > 0 ? t.amber : t.hi }}>{fmtID(r.ar_piutang)}</td>
                        <td style={{ padding: "8px 12px", whiteSpace: "nowrap", color: t.mid }}>{r.catatan || "-"}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            <div style={{ display: "flex", alignItems: "center", justifyContent: "flex-end", gap: 10, padding: 14, borderTop: `1px solid ${t.line}` }}>
              <button onClick={() => fetchRiwayat(page - 1, search)} disabled={page <= 1} style={{ height: 32, padding: "0 12px", borderRadius: 8, border: `1px solid ${t.inputBd}`, background: t.inputBg, color: t.hi, fontSize: 12.5, cursor: page <= 1 ? "default" : "pointer", opacity: page <= 1 ? 0.5 : 1 }}>Sebelumnya</button>
              <span style={{ fontSize: 12.5, color: t.mid }}>Halaman {page} / {totalPages}</span>
              <button onClick={() => fetchRiwayat(page + 1, search)} disabled={page >= totalPages} style={{ height: 32, padding: "0 12px", borderRadius: 8, border: `1px solid ${t.inputBd}`, background: t.inputBg, color: t.hi, fontSize: 12.5, cursor: page >= totalPages ? "default" : "pointer", opacity: page >= totalPages ? 0.5 : 1 }}>Berikutnya</button>
            </div>
          </div>
        </>
      )}

      </>
      )}

      <style>{`.spin { animation: spin 0.8s linear infinite; } @keyframes spin { to { transform: rotate(360deg); } } @keyframes loadingSpin { to { transform: rotate(360deg); } } @keyframes loadingPulse { 0%, 100% { opacity: 0.4; transform: scale(0.85); } 50% { opacity: 1; transform: scale(1); } } @keyframes loadingFadeIn { from { opacity: 0; } to { opacity: 1; } } @keyframes claudeDotWave { 0%, 100% { opacity: 0.22; transform: scale(0.7); } 25% { opacity: 0.55; transform: scale(0.85); } 50% { opacity: 1; transform: scale(1); } 75% { opacity: 0.55; transform: scale(0.85); } } .periodFade { animation: periodFade 0.22s cubic-bezier(0.16, 1, 0.3, 1); } @keyframes periodFade { from { opacity: 0; transform: translateY(-3px) scale(0.98); } to { opacity: 1; transform: translateY(0) scale(1); } } @keyframes modalPopIn { from { opacity: 0; transform: scale(0.94) translateY(6px); } to { opacity: 1; transform: scale(1) translateY(0); } } @keyframes drillCrumbIn { from { opacity: 0; transform: translateX(-6px); } to { opacity: 1; transform: translateX(0); } } @keyframes drillContentIn { from { opacity: 0; transform: translateY(8px) scale(0.985); } to { opacity: 1; transform: translateY(0) scale(1); } } @keyframes sheetUp { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }
        /* UPDATE (permintaan user - "pastikan responsive untuk ukuran
           layar kecil untuk menu DSE Prod & AR"): di layar sempit (hp,
           misal iPhone SE 375px) baris kontrol Periode (toggle Full
           Month/Daily + panah kiri/kanan + label tanggal lebar tetap
           186px) dan baris tab (Penjualan DSE/Riwayat & Laporan/Database
           DSE) lebih lebar dari layar, jadi terpotong & overflow-scroll
           horizontal (keliatan di screenshot: "Oktober 202.." & "Dat.."
           kepotong). Di bawah ini: kontrol Periode jadi full-width &
           wrap ke baris baru kalau perlu, label tanggal lebarnya
           menyesuaikan (bukan fix 186px lagi), dan baris tab jadi wrap
           (bukan inline-flex 1 baris maksa) - supaya semua elemen selalu
           kebaca utuh tanpa perlu scroll ke samping. */
        /* sama spt di atas - margin/padding negatif .dseprod-sticky
           disesuaikan lagi PERSIS di breakpoint mobile .content-pad
           sendiri (640px, padding jadi 20px/16px - lihat
           app/dashboard/page.jsx), bukan breakpoint 560px punya
           header/tabs di bawah ini. */
        /* UPDATE (permintaan user - screenshot 784px: "mengapa tidak
           langsung dipisah menjadi 2 baris" -> klarifikasi "maksudnya
           otomatis, jika sudah tidak muat groupnya langsung berubah
           format urutannya, jadi setiap ukuran layar benar2 rapi"): dulu
           di rentang ~641-900px, title & blok kontrol (collapseBtn+
           Daily/Full Month+nav tanggal) dipaksa MENGECIL (font/padding
           !important) biar tetap muat 1 baris - persis kebalikan dari yg
           diminta sekarang. Blok media query itu DIHAPUS total: .dseprod-
           header sudah flexWrap:"wrap" dari sononya, dan .dseprod-controls
           dirender sbg SATU blok (bukan display:contents) - jadi begitu
           title+kontrol kehabisan ruang di satu baris, browser OTOMATIS
           ngejatuhin seluruh blok kontrol ke baris ke-2 (native CSS wrap,
           bukan breakpoint JS manual), rapi di SEMUA lebar layar tanpa
           perlu dipatok per-pixel lagi. */
        @media (max-width: 640px) {
          .dseprod-sticky { margin-left: -16px !important; margin-right: -16px !important; padding-top: 20px !important; padding-left: 16px !important; padding-right: 16px !important; }
        }
        @media (max-width: 560px) {
          /* UPDATE (permintaan user - "ini juga pastikan satu line",
             screenshot: baris Filter + Cari Kode DSE + Refresh kebagi 2
             baris di mobile krn kotak "Cari Kode DSE" minWidth:180 ga
             muat sejajar dgn tombol Filter & Refresh di layar sempit).
             Filter & Refresh dikunci ga nyusut (flexShrink:0, udah
             dipasang inline), kotak Cari Kode DSE-nya yg nyusut
             (minWidth:0 ganti dari 180 cuma di breakpoint ini, flex:1
             udah ada dari sananya) - karena search-nya bisa nyusut
             sampai 0, flex-wrap:wrap bawaan ga akan pernah kepaksa
             mindahin Filter/Search/Refresh ke baris baru lagi; tombol
             "Simpan Semua" (cuma muncul kalau ada perubahan) tetap bebas
             wrap ke baris sendiri kalau ruang emang abis, bukan maksa
             nyempitin yg lain. */
          .dseprod-filtersearch { min-width: 0 !important; }
          .dseprod-filtersearch input { font-size: 12.5px !important; }

          /* UPDATE (permintaan user - "perbaiki total masih berantakan,
             pastikan mudah digunakan di mobile"): percobaan pertama cuma
             "wrap + center" bikin elemen2 nyebar ga rata (toggle
             Full Month/Daily ngambang di tengah dgn ruang kosong di
             kanan-kiri, panah nav kejauhan dari label, tab "Database DSE"
             sendirian misah di baris ke-2 ga sejajar dgn 2 tab lainnya).
             Sekarang re-desain PENUH jadi susunan vertikal yg jelas &
             konsisten lebarnya (semua elemen width:100%, bukan centered
             dgn sisa ruang kosong):
             1. Toggle Full Month/Daily → full width, 2 tombol dibagi rata.
             2. Baris nav tanggal (◀ label ▶) → full width, label di tengah
                mengisi SEMUA sisa ruang (flex:1, bukan lebar tetap 186px
                yg kekecilan/ga center sempurna).
             3. Tab (Penjualan DSE / Riwayat & Laporan / Database DSE) →
                SELALU 1 baris (3 kolom rata lebar, flex:1 masing2, TIDAK
                wrap lagi) - label boleh turun ke baris ke-2 DI DALAM
                tombolnya sendiri kalau teksnya kepanjangan, drpd 1 tab
                lompat ke baris terpisah sendirian & keliatan "nyasar". */
          .dseprod-header { padding: 10px 12px !important; row-gap: 8px !important; }
          .dseprod-title-icon { width: 30px !important; height: 30px !important; }
          .dseprod-title-text { font-size: 15.5px !important; }
          .dseprod-period-label { min-width: 0; }
          .dseprod-period-label span { overflow: hidden; text-overflow: ellipsis; }
          .dseprod-navbtn { flex-shrink: 0 !important; }
          /* UPDATE (permintaan user - sebelumnya icon dipindah ke ATAS
             label [lihat riwayat di bawah] krn ada 3 tab & salah satu
             labelnya ["Riwayat & Laporan"] suka wrap 2 baris. Sekarang
             tab tinggal 2 ("Penjualan DSE" & "AR DSE") & dua2nya label
             PENDEK, ga perlu wrap - jadi permintaan user "dibuat menjadi
             satu baris saja agar tidak makan space" diterapkan: icon &
             label balik SEJAJAR (row, bukan column) dlm 1 baris, padding
             vertikal dikecilin, drastis ngirit tinggi tab-bar di layar
             sempit dibanding versi icon-di-atas sebelumnya. */
          .dseprod-tabs { display: flex !important; flex-wrap: nowrap; align-items: stretch; width: 100%; gap: 2px; }
          .dseprod-tabs button { flex: 1 1 0; min-width: 0; flex-direction: row !important; justify-content: center; align-items: center; gap: 5px !important; white-space: nowrap !important; text-align: center; padding: 9px 6px !important; font-size: 11.5px !important; line-height: 1.2 !important; }
        }
      `}</style>
      {showCetakBulk && typeof document !== "undefined" && createPortal(
        <ArCetakBulkModal t={t} arMonth={calViewMonth} list={bulkList} profile={profile} onClose={() => setShowCetakBulk(false)} />,
        document.body
      )}
    </div>
  );
}
