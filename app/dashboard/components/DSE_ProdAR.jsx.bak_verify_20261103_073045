        <div><span style={{ fontWeight: 700 }}>Nama DSE:</span> {dseName || "-"}</div>
        <div><span style={{ fontWeight: 700 }}>MC:</span> {mc || "-"}</div>
        <div><span style={{ fontWeight: 700 }}>Branch:</span> {branch || "-"}</div>
