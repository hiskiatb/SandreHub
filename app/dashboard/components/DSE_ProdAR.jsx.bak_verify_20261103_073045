function Toast({ msg, type, onClose }) {
  useEffect(() => { const t = setTimeout(onClose, 4500); return () => clearTimeout(t); }, [onClose]);
  const bg = type === "error" ? "#DC2626" : type === "warn" ? "#D97706" : "#16A34A";
  return (
    <div style={{ position: "fixed", bottom: 24, right: 24, left: 24, zIndex: 9999, display: "flex", alignItems: "center", gap: 10, padding: "12px 16px", borderRadius: 10, background: bg, color: "#fff", fontSize: 13.5, fontWeight: 600, fontFamily: FONT, boxShadow: "0 8px 24px rgba(0,0,0,0.25)", maxWidth: 480, marginLeft: "auto" }}>
      {type === "error" ? <AlertTriangle size={15} /> : <Check size={15} />}
      <span style={{ flex: 1 }}>{msg}</span>
      <button onClick={onClose} style={{ background: "none", border: "none", color: "#fff", cursor: "pointer", padding: 0, display: "flex" }}><X size={14} /></button>
    </div>
  );
}

// ── Label field yang enak dibaca utk popup Riwayat (lihat DseHistoryModal) —
// field_name mentah dari mf_dse_database_history (nama kolom DB) dipetakan
// ke label Indonesia yang sama dgn yang dipakai di form Upload Data/Database
// DSE, supaya konsisten.
const HISTORY_FIELD_LABEL = {
  _created: "Dibuat",
  dse_category: "DSE Category",
  dse_code_3id: "DSE Code 3ID",
  mdi: "MDI",
  pt_name: "PT",
  mc: "Micro Cluster",
  branch: "Branch",
  region: "Region",
  circle: "Circle",
  dse_status: "Status",
  ds_name: "Nama DSE",
  join_date: "Join Date",
};

// ── Popup Riwayat Perubahan per ID DSE — dibuka dgn klik ID DSE di tab Input
// Harian. Data dari mf_dse_database_history, yang diisi otomatis oleh DB
// trigger trg_mf_dse_database_log_changes tiap kali mf_dse_database
// di-INSERT/UPDATE (baik lewat Upload Data/wizard maupun edit identitas di
// sini) — jadi audit trail-nya menangkap SEMUA jalur perubahan, bukan cuma
// yang lewat UI ini.
// UPDATE (permintaan user - "pastikan semua perubahan tersimpan dengan aman
// dan setiap id memiliki log tersendiri" -> "log nya mulai dari perubahan
// identitas, penjualan masing2, dan juga AR, agar sangat jelas"): popup
// Riwayat skrg gabungin 2 sumber log per dse_code jadi SATU timeline,
// masing2 ditandain badge kategori yg jelas:
//  - IDENTITAS (teal)   <- mf_dse_database_history (udah ada dari dulu, per
//    field diff Nama/Status/Join Date/dll, trigger trg_mf_dse_database_log_changes)
//  - PENJUALAN <brand> (warna brand, lihat BRAND_META) <- mf_dse_prod_ar_history
//    (BARU, trigger trg_mf_dse_prod_ar_log_history di migration
//    "mf_dse_prod_ar_history" - mencatat snapshot nilai SEBELUM tiap kali
//    baris mf_dse_prod_ar di-UPDATE/DELETE: SP/Voucher/Saldo dipisah jelas
//    dari AR/Piutang & Catatan di card yg sama, biar gampang dibaca mana yg
//    penjualan mana yg piutang).
function DseHistoryModal({ t, dseCode, dse, initialTab, initialMonth, onClose }) {
  // UPDATE (permintaan user - "riwayat perubahan, ini kita akan rework,
  // per masing masing sub menu, jadi ada Riwayat Informasi DSE, Riwayat
  // Penjualan SP, Riwayat Penjualan Voucher, dan juga Penjualan Saldo,
  // jadi untuk penjualan akan ada semua tanggal bahkan untuk hari yang
  // tidak ada penjualan, namun untuk informasi DSE dia hanya akan
  // menampilkan yang ada riwayatnya namun untuk riwayat ini bisa dihapus
  // namun dia akan konfirmasi dan disuruh ketik HAPUS lagi" + "dan untuk
  // riwayat penjualan juga bisa diedit hari demi harinya langsung" +
  // "buat dengan ui ux terbaik"): popup ini dulu 1 timeline gabungan
  // (identitas + snapshot-sebelum-perubahan penjualan jadi satu list).
  // Sekarang dipecah jadi 4 sub-tab:
  //  - "info"    -> tetap dari mf_dse_database_history (cuma nongol kalau
  //    MEMANG ada riwayat perubahan - _created/ds_name/dse_status).
  //  - "sp"/"voucher"/"saldo" -> BUKAN lagi dari tabel log perubahan
  //    (mf_dse_prod_ar_history, yg cuma nyimpen snapshot SEBELUM
  //    update/delete), tapi LANGSUNG dari mf_dse_prod_ar (data harian
  //    yg sesungguhnya) - jadi SEMUA tanggal yg punya baris tetap
  //    tampil, termasuk yg nilainya 0/belum ada penjualan hari itu.
  //    Tiap baris tanggal di 3 tab ini bisa diedit LANGSUNG (pensil ->
  //    input angka -> Simpan) & bisa dihapus/direset ke 0 (tombol
  //    sampah -> wajib ketik "HAPUS" dulu, krn ini data transaksi nyata).
  const [historyTab, setHistoryTab] = useState(initialTab || "info");
  // UPDATE (permintaan user - "tanggal 1 kan juga terlihat untuk riwayat
  // smua tanggal pada bulan ini, tandai harinya juga buat sangat rapi dan
  // bisa langsung edit, dan disini ada total penjualan bulan ini"): tab
  // Penjualan SP/Voucher/Saldo sekarang nampilin SATU BULAN PENUH (semua
  // tanggal 1..akhir bulan, termasuk yg blm ada baris di DB sama sekali -
  // disintesis jadi 0), bukan cuma baris2 yg kebetulan ada datanya -
  // bulan yg ditampilkan ikut bulan yg lagi aktif di induk (initialMonth),
  // tapi bisa digeser maju/mundur sendiri via historyMonth.
  const [historyMonth, setHistoryMonth] = useState(initialMonth || todayISO().slice(0, 7));
  const [nameRows, setNameRows] = useState([]);
  const [prodRows, setProdRows] = useState([]);
  const [loading, setLoading] = useState(true);
  const [errMsg, setErrMsg] = useState("");
  const [names, setNames] = useState({});

  // Edit-inline 1 baris tanggal pada satu waktu (sp/voucher/saldo).
  const [editTanggal, setEditTanggal] = useState(null);
  const [editDraft, setEditDraft] = useState({ nilai: "0" });
  const [savingTanggal, setSavingTanggal] = useState(null);

  // Konfirmasi hapus (wajib ketik "HAPUS") - dipakai bareng utk hapus
  // baris log identitas (tab Info) MAUPUN reset nilai 1 metric di 1
  // tanggal tertentu (tab SP/Voucher/Saldo) jadi 0.
  const [confirmTarget, setConfirmTarget] = useState(null); // { kind, id?, tanggal?, label }
  const [confirmTyped, setConfirmTyped] = useState("");
  const [deleting, setDeleting] = useState(false);

  useEffect(() => {
    let alive = true;
    (async () => {
      setLoading(true); setErrMsg("");
      try {
        const [{ data: idData, error: idErr }, { data: prodData, error: prodErr }] = await Promise.all([
          supabase.from("mf_dse_database_history").select("*").eq("dse_code", dseCode).in("field_name", ["ds_name", "_created", "dse_status"]).order("changed_at", { ascending: false }).limit(150),
          supabase.from("mf_dse_prod_ar").select("*").eq("dse_code", dseCode).order("tanggal", { ascending: false }).limit(366),
        ]);
        if (idErr) throw idErr;
        if (prodErr) throw prodErr;
        if (!alive) return;
        setNameRows(idData || []);
        setProdRows(prodData || []);
        const ids = Array.from(new Set((idData || []).map((r) => r.changed_by).filter(Boolean)));
        if (ids.length) {
          const { data: profs } = await supabase.from("profiles").select("id, full_name").in("id", ids);
          if (alive) setNames(Object.fromEntries((profs || []).map((p) => [p.id, p.full_name])));
        }
      } catch (e) {
        if (alive) setErrMsg(e.message || "Gagal memuat riwayat.");
      } finally {
        if (alive) setLoading(false);
      }
    })();
    return () => { alive = false; };
  }, [dseCode]);

  const HistoryCard = ({ icon, iconColor, iconBg, badgeLabel, badgeColor, badgeBg, title, timeLabel, changedBy, children, onDeleteClick }) => (
    <div style={{ display: "flex", gap: 11, borderRadius: 14, border: `1px solid ${t.line}`, background: t.card, boxShadow: t.shadowSm, padding: "13px 14px" }}>
      <div style={{ width: 32, height: 32, borderRadius: 10, background: iconBg, display: "flex", alignItems: "center", justifyContent: "center", flexShrink: 0 }}>
        {icon}
      </div>
      <div style={{ flex: 1, minWidth: 0 }}>
        <div style={{ display: "flex", alignItems: "flex-start", justifyContent: "space-between", gap: 8, marginBottom: 2 }}>
          <div style={{ display: "flex", alignItems: "center", gap: 7, minWidth: 0, flexWrap: "wrap" }}>
            <span style={{ display: "inline-flex", alignItems: "center", padding: "2px 8px", borderRadius: 999, background: badgeBg, fontSize: 10, fontWeight: 800, color: badgeColor, textTransform: "uppercase", letterSpacing: 0.3, flexShrink: 0 }}>{badgeLabel}</span>
            <span style={{ fontSize: 12.5, fontWeight: 700, color: t.hi }}>{title}</span>
          </div>
          <div style={{ display: "flex", alignItems: "center", gap: 6, flexShrink: 0 }}>
            <span style={{ fontSize: 10.5, color: t.lo, whiteSpace: "nowrap" }}>{timeLabel}</span>
            {onDeleteClick && (
              <button onClick={onDeleteClick} title="Hapus" style={{ width: 22, height: 22, borderRadius: 7, border: "none", background: "transparent", color: t.lo, cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center" }}>
                <Trash2 size={13} />
              </button>
            )}
          </div>
        </div>
        {children}
        {changedBy && <div style={{ fontSize: 10.5, color: t.lo, marginTop: 6 }}>oleh {changedBy}</div>}
      </div>
    </div>
  );

  // Kotak konfirmasi "ketik HAPUS" - dirender di BAWAH kartu yg lagi
  // di-hapus, bukan dialog terpisah, biar jelas konteksnya (kartu mana
  // yg mau dihapus) & ga nutupin seluruh popup.
  const ConfirmHapusBox = () => (
    <div style={{ marginTop: 8, padding: 10, borderRadius: 10, background: "rgba(220,38,38,0.08)", border: `1px solid ${t.red}40` }}>
      <div style={{ fontSize: 11.5, fontWeight: 700, color: t.red, marginBottom: 7 }}>Hapus {confirmTarget.label}? Tindakan ini permanen. Ketik <b>HAPUS</b> untuk konfirmasi.</div>
      <div style={{ display: "flex", gap: 6 }}>
        <input autoFocus value={confirmTyped} onChange={(ev) => setConfirmTyped(ev.target.value)} placeholder="HAPUS"
          style={{ flex: 1, height: 32, padding: "0 10px", borderRadius: 7, border: `1px solid ${t.red}55`, background: t.card, color: t.hi, fontSize: 12.5, fontFamily: FONT, outline: "none", boxSizing: "border-box" }} />
        <button disabled={confirmTyped !== "HAPUS" || deleting} onClick={handleConfirmDelete}
          style={{ height: 32, padding: "0 14px", borderRadius: 7, border: "none", background: confirmTyped === "HAPUS" ? t.red : t.inputBg, color: confirmTyped === "HAPUS" ? "#fff" : t.lo, fontWeight: 700, fontSize: 12, cursor: confirmTyped === "HAPUS" && !deleting ? "pointer" : "default", display: "flex", alignItems: "center", gap: 5, flexShrink: 0 }}>
          {deleting ? <Loader2 size={13} className="spin" /> : <Trash2 size={13} />} Hapus
        </button>
        <button onClick={() => { setConfirmTarget(null); setConfirmTyped(""); }} style={{ height: 32, padding: "0 12px", borderRadius: 7, border: "none", background: t.inputBg, color: t.mid, fontWeight: 700, fontSize: 12, cursor: "pointer", flexShrink: 0 }}>Batal</button>
      </div>
    </div>
  );

  const handleConfirmDelete = async () => {
    if (!confirmTarget || confirmTyped !== "HAPUS") return;
    setDeleting(true);
    try {
      if (confirmTarget.kind === "info") {
        const { error } = await supabase.from("mf_dse_database_history").delete().eq("id", confirmTarget.id);
        if (error) throw error;
        setNameRows((rows) => rows.filter((r) => r.id !== confirmTarget.id));
      } else {
        // Reset NILAI metric itu sendiri jadi 0 di tanggal tsb (qty_* TIDAK
        // disentuh lagi, lihat UPDATE di startEdit/saveEdit) - baris
        // mf_dse_prod_ar (& metric lain di tanggal yg sama: AR/Catatan/
        // metric lain) TETAP ada, krn 1 baris = 1 hari gabungan semua jenis.
        const col = confirmTarget.kind === "sp" ? "nilai_sp" : confirmTarget.kind === "voucher" ? "nilai_voucher" : "nilai_saldo";
        const patch = { [col]: 0 };
        const { error } = await supabase.from("mf_dse_prod_ar").update(patch).eq("dse_code", dseCode).eq("tanggal", confirmTarget.tanggal);
        if (error) throw error;
        setProdRows((rows) => rows.map((r) => (r.tanggal === confirmTarget.tanggal ? { ...r, ...patch } : r)));
      }
      setConfirmTarget(null);
      setConfirmTyped("");
    } catch (e) {
      setErrMsg(e.message || "Gagal menghapus.");
    } finally {
      setDeleting(false);
    }
  };

  // UPDATE (permintaan user - "mengapa ini ada qty, bukannya kita sudah
  // menghilangkannya"): konsep Qty (pcs) udah dihapus dari seluruh input
  // penjualan di aplikasi ini (cuma Nilai/Rp yg diisi admin) - popup
  // riwayat ini msh nyisa field Qty krn blm ikut di-update. Sekarang
  // edit/tampilan di sini CUMA nilai (Rp) - kolom qty_sp/qty_voucher/
  // qty_saldo di DB TETAP ga disentuh (dibiarkan apa adanya, bukan
  // di-reset ke 0) krn itu bukan lagi konsep yg dikelola dari UI manapun.
  const nilaiColOf = (kind) => (kind === "sp" ? "nilai_sp" : kind === "voucher" ? "nilai_voucher" : "nilai_saldo");
  const startEdit = (row, kind) => {
    setEditTanggal(row.tanggal);
    setEditDraft({ nilai: String(row[nilaiColOf(kind)] || 0) });
  };
  const saveEdit = async (row, kind) => {
    const patch = { [nilaiColOf(kind)]: fRaw(editDraft.nilai) };
    setSavingTanggal(row.tanggal);
    try {
      const exists = row.__exists !== false;
      if (exists) {
        const { error } = await supabase.from("mf_dse_prod_ar").update(patch).eq("dse_code", dseCode).eq("tanggal", row.tanggal);
        if (error) throw error;
      } else {
        // UPDATE (permintaan user - "tanggal 1 kan juga terlihat ... bisa
        // langsung edit"): tanggal yg blm punya baris SAMA SEKALI di DB
        // (disintesis jadi 0 cuma utk ditampilin) - begitu diisi, insert
        // baris baru dulu (bukan update, krn belum ada barisnya).
        const { error } = await supabase.from("mf_dse_prod_ar").insert({ dse_code: dseCode, tanggal: row.tanggal, ...patch });
        if (error) throw error;
      }
      setProdRows((rows) => {
        const has = rows.some((r) => r.tanggal === row.tanggal);
        return has ? rows.map((r) => (r.tanggal === row.tanggal ? { ...r, ...patch } : r)) : [...rows, { dse_code: dseCode, tanggal: row.tanggal, ...patch }];
      });
      setEditTanggal(null);
    } catch (e) {
      setErrMsg(e.message || "Gagal menyimpan perubahan.");
    } finally {
      setSavingTanggal(null);
    }
  };
  // Bangun daftar SEMUA tanggal 1..akhir bulan utk `historyMonth`,
  // digabung dgn prodRows (yg beneran ada di DB) - tanggal yg blm ada
  // barisnya disintesis jadi baris kosong (__exists:false) supaya tetap
  // kelihatan & bisa langsung diisi, bukan cuma "ngilang" krn 0.
  // UPDATE (permintaan user - "ini sampai dengan tanggal berjalan saja"):
  // bulan BERJALAN (historyMonth === bulan ini) ga perlu nampilin
  // tanggal2 yg BELUM TIBA (3,4,5 Nov dst kalau hari ini msh 2 Nov) -
  // ga ada gunanya nampilin "belum ada penjualan" utk hari yg blm
  // kejadian. Dibatasi sampai `today` kalau historyMonth = bulan
  // berjalan; bulan2 LALU tetap nampilin SEMUA tanggal (1..akhir bulan)
  // krn semuanya udah lewat & valid utk dicek/diedit.
  const monthDayRows = useMemo(() => {
    const [y, m] = historyMonth.split("-").map(Number);
    const daysInMonth = new Date(y, m, 0).getDate();
    const today = todayISO();
    const isCurrentMonth = historyMonth === today.slice(0, 7);
    const lastDay = isCurrentMonth ? Number(today.slice(8, 10)) : daysInMonth;
    const byTanggal = new Map(prodRows.map((r) => [r.tanggal, r]));
    const out = [];
    for (let d = 1; d <= lastDay; d++) {
      const tanggal = `${y}-${pad2(m)}-${pad2(d)}`;
      const row = byTanggal.get(tanggal);
      out.push(row ? { ...row, __exists: true } : { dse_code: dseCode, tanggal, nilai_sp: 0, nilai_voucher: 0, nilai_saldo: 0, qty_sp: 0, qty_voucher: 0, qty_saldo: 0, __exists: false });
    }
    return out;
  }, [prodRows, historyMonth, dseCode]);

  // UPDATE (ui ux): tab bar 4 sub-menu, style konsisten dgn sheetTabs di
  // popup edit DSE (DseInputRow) - grid 2x2, ikon+label, aktif = teal.
  const HISTORY_TABS = [
    { k: "info", label: "Informasi DSE", icon: Users },
    { k: "sp", label: "Penjualan SP", icon: SimCardIcon, color: t.red, bg: t.redBg },
    { k: "voucher", label: "Penjualan Voucher", icon: Ticket, color: t.blue, bg: t.blueBg },
    { k: "saldo", label: "Penjualan Saldo", icon: Wallet, color: t.amber, bg: t.amberBg },
  ];

  const renderSalesTab = (kind, label, color, bg, Icon) => {
    const nilaiCol = nilaiColOf(kind);
    const totalNilai = monthDayRows.reduce((s, r) => s + fRaw(r[nilaiCol]), 0);
    const [hy, hm] = historyMonth.split("-").map(Number);
    const monthLabel = `${MONTH_NAMES[hm - 1]} ${hy}`;
    const today = todayISO();
    return (
      <div style={{ display: "flex", flexDirection: "column", gap: 9 }}>
        {/* UPDATE (permintaan user - "ada total penjualan bulan ini,
            tergantung section semisal sedang membuka sp, maka total
            penjualan sp November"): kartu ringkasan total Nilai {label}
            utk SELURUH bulan yg lagi ditampilkan, plus navigasi
            maju/mundur bulan (ganti bulan = ganti isi monthDayRows,
            lihat useMemo di atas). */}
        <div style={{ borderRadius: 14, border: `1px solid ${t.line}`, background: bg, padding: "12px 14px", display: "flex", alignItems: "center", gap: 10 }}>
          <button onClick={() => setHistoryMonth((m) => shiftMonth(m, -1))} title="Bulan sebelumnya"
            style={{ width: 28, height: 28, borderRadius: 8, border: "none", background: "rgba(255,255,255,0.55)", color, cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center", flexShrink: 0 }}>
            <ChevronDown size={13} style={{ transform: "rotate(90deg)" }} />
          </button>
          <div style={{ flex: 1, minWidth: 0 }}>
            <div style={{ fontSize: 10, fontWeight: 800, color, textTransform: "uppercase", letterSpacing: 0.3 }}>Total Penjualan {label} · {monthLabel}</div>
            <div style={{ fontSize: 17, fontWeight: 800, color: t.hi, fontVariantNumeric: "tabular-nums", marginTop: 1 }}>Rp {fmtID(totalNilai)}</div>
          </div>
          <button onClick={() => setHistoryMonth((m) => shiftMonth(m, 1))} disabled={historyMonth >= today.slice(0, 7)} title="Bulan berikutnya"
            style={{ width: 28, height: 28, borderRadius: 8, border: "none", background: historyMonth >= today.slice(0, 7) ? "transparent" : "rgba(255,255,255,0.55)", color: historyMonth >= today.slice(0, 7) ? t.line : color, cursor: historyMonth >= today.slice(0, 7) ? "default" : "pointer", display: "flex", alignItems: "center", justifyContent: "center", flexShrink: 0 }}>
            <ChevronDown size={13} style={{ transform: "rotate(-90deg)" }} />
          </button>
        </div>

        {monthDayRows.map((row) => {
          const nilai = fRaw(row[nilaiCol]);
          const isEditing = editTanggal === row.tanggal;
          const isSaving = savingTanggal === row.tanggal;
          const isConfirming = confirmTarget?.kind === kind && confirmTarget?.tanggal === row.tanggal;
          const isToday = row.tanggal === today;
          return (
            <div key={row.tanggal} style={{ borderRadius: 14, border: `1px solid ${isToday ? color : t.line}`, background: t.card, boxShadow: t.shadowSm, padding: "13px 14px", position: "relative" }}>
              <div style={{ display: "flex", gap: 11, alignItems: "flex-start" }}>
                <div style={{ width: 32, height: 32, borderRadius: 10, background: bg, display: "flex", alignItems: "center", justifyContent: "center", flexShrink: 0 }}>
                  <Icon size={15} color={color} />
                </div>
                <div style={{ flex: 1, minWidth: 0 }}>
                  <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", gap: 8 }}>
                    <div style={{ display: "flex", alignItems: "center", gap: 6, minWidth: 0 }}>
                      <span style={{ fontSize: 12.5, fontWeight: 700, color: t.hi, whiteSpace: "nowrap" }}>{fmtLongDate(row.tanggal)}</span>
                      {isToday && <span style={{ flexShrink: 0, padding: "1.5px 7px", borderRadius: 999, background: color, color: "#fff", fontSize: 9, fontWeight: 800, textTransform: "uppercase", letterSpacing: 0.3 }}>Hari Ini</span>}
                    </div>
                    {!isEditing && (
                      <div style={{ display: "flex", alignItems: "center", gap: 4, flexShrink: 0 }}>
                        <button onClick={() => startEdit(row, kind)} title="Edit nilai hari ini" style={{ width: 22, height: 22, borderRadius: 7, border: "none", background: t.sub, color: t.mid, cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center" }}>
                          <Pencil size={11} />
                        </button>
                        {nilai > 0 && (
                          <button onClick={() => { setConfirmTarget({ kind, tanggal: row.tanggal, label: `Penjualan ${label} ${fmtLongDate(row.tanggal)}` }); setConfirmTyped(""); }} title="Reset ke 0" style={{ width: 22, height: 22, borderRadius: 7, border: "none", background: "transparent", color: t.lo, cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center" }}>
                            <Trash2 size={12} />
                          </button>
                        )}
                      </div>
                    )}
                  </div>
                  {isEditing ? (
                    // UPDATE (permintaan user - "perbaiki uinya"): dulu
                    // tombol Simpan/Batal nempel LANGSUNG di bawah input
                    // tanpa jarak/pemisah (keliatan "numpuk" sama field
                    // di atasnya) + Simpan di KIRI (ga konsisten sama
                    // footer popup lain di file ini yg selalu Batal KIRI,
                    // Simpan KANAN). Dipoles: pemisah garis putus2 +
                    // padding atas sebelum baris tombol, urutan dibalik
                    // (Batal kiri sbg aksi sekunder outline, Simpan kanan
                    // sbg aksi utama solid teal) - match 1 bahasa visual
                    // sama footer popup edit DSE/konfirmasi lain.
                    <div style={{ marginTop: 10, display: "flex", flexDirection: "column", gap: 10 }}>
                      <div>
                        <div style={{ fontSize: 9.5, fontWeight: 700, color: t.lo, textTransform: "uppercase", letterSpacing: 0.2, marginBottom: 3 }}>Total Penjualan {label} (Rp)</div>
                        <MoneyInput t={t} value={editDraft.nilai} onChange={(v) => setEditDraft((d) => ({ ...d, nilai: v }))} />
                      </div>
                      <div style={{ display: "flex", gap: 8, paddingTop: 10, borderTop: `1px dashed ${t.line}` }}>
                        <button onClick={() => setEditTanggal(null)} disabled={isSaving}
                          style={{ height: 32, padding: "0 14px", borderRadius: 8, border: `1px solid ${t.inputBd}`, background: t.inputBg, color: t.mid, fontWeight: 700, fontSize: 12, cursor: "pointer", fontFamily: FONT }}>
                          Batal
                        </button>
                        <button onClick={() => saveEdit(row, kind)} disabled={isSaving}
                          style={{ flex: 1, height: 32, borderRadius: 8, border: "none", background: t.teal, color: "#fff", fontWeight: 700, fontSize: 12, cursor: isSaving ? "default" : "pointer", display: "flex", alignItems: "center", justifyContent: "center", gap: 5, opacity: isSaving ? 0.7 : 1, fontFamily: FONT }}>
                          {isSaving ? <Loader2 size={13} className="spin" /> : <Save size={12} />} Simpan
                        </button>
                      </div>
                    </div>
                  ) : (
                    <div style={{ display: "flex", alignItems: "baseline", gap: 8, marginTop: 3 }}>
