const RANK_BADGE_COLORS = ["#D4A017", "#9CA3AF", "#B5651D"];
function RankBadge({ i, t }) {
  if (i === 0) return <Crown size={16} color={RANK_BADGE_COLORS[0]} fill={RANK_BADGE_COLORS[0]} fillOpacity={0.18} />;
  if (i === 1) return <Medal size={16} color={RANK_BADGE_COLORS[1]} />;
  if (i === 2) return <Medal size={16} color={RANK_BADGE_COLORS[2]} />;
  return (
    <span style={{ width: 22, height: 22, borderRadius: "50%", background: t.sub, color: t.mid, fontSize: 10.5, fontWeight: 800, display: "flex", alignItems: "center", justifyContent: "center" }}>
      {i + 1}
    </span>
  );
}

// UPDATE (permintaan user - "kita bisa pilih ada rank by Total penjualan,
// atau penjualan SP, atau penjualan Voucher / Penjualan Saldo, jadi ada
// tombol sort di kolom rank"): dropdown kecil nempel di header kolom Rank,
// dipakai bareng di kedua tabel di atas via prop rankMetric/onRankMetricChange
// yg di-share dari state induk DSE_ProdAR (1 pilihan metric berlaku ke
// SEMUA tampilan sekaligus).
const RANK_METRIC_OPTIONS = [
  { v: "total", label: "Total Penjualan" },
  { v: "sp", label: "Penjualan SP" },
  { v: "voucher", label: "Penjualan Voucher" },
  { v: "saldo", label: "Penjualan Saldo" },
];
function RankMetricMenu({ t, value, onChange }) {
  // UPDATE (permintaan user - "masih terhalang elemen lain, perbaiki"):
  // dropdown absolute-positioned di dalam <div> header tabel kena
  // overflow:hidden/overflowX:auto milik container tabel di sekelilingnya
  // (sama kasusnya kyk ExcelFilter), jadi dipindah ke createPortal ke
  // document.body + posisi "fixed" dihitung dari getBoundingClientRect
  // tombolnya sendiri - persis pola yg dipakai ExcelFilter.jsx.
  const [open, setOpen] = useState(false);
  const [pos, setPos] = useState({ x: 0, y: 0 });
  const btnRef = useRef(null);
  const menuRef = useRef(null);
  const toggleOpen = () => {
    if (!open && btnRef.current) {
      const rect = btnRef.current.getBoundingClientRect();
      const menuW = 190;
      let x = rect.left;
      let y = rect.bottom + 6;
      if (x + menuW > window.innerWidth) x = window.innerWidth - menuW - 12;
      if (y + 190 > window.innerHeight) y = rect.top - 190 - 6;
      setPos({ x, y });
    }
    setOpen((v) => !v);
  };
  useEffect(() => {
    if (!open) return undefined;
    const onDoc = (ev) => {
      if (btnRef.current?.contains(ev.target)) return;
      if (menuRef.current?.contains(ev.target)) return;
      setOpen(false);
    };
    document.addEventListener("mousedown", onDoc);
    return () => document.removeEventListener("mousedown", onDoc);
  }, [open]);
  const current = RANK_METRIC_OPTIONS.find((o) => o.v === value) || RANK_METRIC_OPTIONS[0];
  return (
    <>
      <button ref={btnRef} onClick={(ev) => { ev.stopPropagation(); toggleOpen(); }} title={`Urutkan Rank berdasarkan: ${current.label}`}
        style={{ display: "flex", alignItems: "center", justifyContent: "center", width: 20, height: 20, borderRadius: 6, border: "none", background: "transparent", color: t.lo, cursor: "pointer", padding: 0, flexShrink: 0 }}>
        <ArrowUpDown size={11} />
      </button>
      {open && typeof document !== "undefined" && createPortal(
        <div ref={menuRef} style={{ position: "fixed", left: pos.x, top: pos.y, zIndex: 9999, background: t.card, border: `1px solid ${t.line}`, borderRadius: 9, boxShadow: "0 8px 24px rgba(0,0,0,0.16)", minWidth: 180, padding: 4 }}>
          <div style={{ padding: "6px 9px 4px", fontSize: 9.5, fontWeight: 800, color: t.lo, textTransform: "uppercase", letterSpacing: 0.3 }}>Urutkan Rank</div>
          {RANK_METRIC_OPTIONS.map((o) => (
            <button key={o.v} onClick={(ev) => { ev.stopPropagation(); onChange(o.v); setOpen(false); }}
              style={{ display: "flex", alignItems: "center", justifyContent: "space-between", width: "100%", textAlign: "left", padding: "7px 9px", borderRadius: 6, border: "none", background: value === o.v ? t.tealBg : "transparent", color: value === o.v ? t.teal : t.hi, fontSize: 12, fontWeight: value === o.v ? 700 : 600, cursor: "pointer", fontFamily: FONT }}>
              {o.label}
              {value === o.v && <Check size={12} />}
            </button>
          ))}
        </div>,
        document.body
      )}
    </>
  );
}
const rankMetricValueOf = (obj, metric) => (
  metric === "sp" ? obj.nilaiSp
  : metric === "voucher" ? obj.nilaiVoucher
  : metric === "saldo" ? obj.nilaiSaldo
