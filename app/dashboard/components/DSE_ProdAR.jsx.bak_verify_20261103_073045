  const branchOptions = useMemo(() => Array.from(new Set(
    dseMeta.filter((r) => (!partnerFilter || r.mdi === partnerFilter) && (!regionFilter || r.region === regionFilter)).map((r) => r.branch).filter(Boolean)
  )).sort(), [dseMeta, partnerFilter, regionFilter]);
  const mcOptions = useMemo(() => Array.from(new Set(
    dseMeta.filter((r) => (!partnerFilter || r.mdi === partnerFilter) && (!regionFilter || r.region === regionFilter) && (!branchFilter || r.branch === branchFilter)).map((r) => r.mc).filter(Boolean)
  )).sort(), [dseMeta, partnerFilter, regionFilter, branchFilter]);

  // ── Ringkasan per Region ("ALL Sumatera", tampilan default saat belum
  // pilih Region/Branch/MC sama sekali) — permintaan user: "secara default
  // pada region ALL sumatera, sehingga menampilkan angka per masing masing
  // region". Beda dgn tabel input (yg butuh Region/Branch/MC dipilih dulu
  // spy tidak menarik SELURUH roster DSE sekaligus utk diedit), ringkasan
  // ini cuma menjumlahkan angka — aman dimuat tanpa filter apa pun, lalu
  // klik salah satu Region utk drill-down ke tabel input region itu. ──
  const [regionSummary, setRegionSummary] = useState([]);
  const [loadingRegionSummary, setLoadingRegionSummary] = useState(false);
  // UPDATE (permintaan user - "perbaiki setiap card ini jadi setiap view
  // yang dipilih dia akan menyesuaikan ke penjualan terbanyak sesuai
  // filter yang dipilih, bisa daily / full month"): sebelumnya Ringkasan
  // per Region/Partner/dst cuma tampil di mode Daily (!isRangeMode) -
  // sekarang jalan juga di mode Full Month (isRangeMode true), data
  // diakumulasi persis spt tabel input (lihat loadRegionSummary).
  // UPDATE (permintaan user - navigasi hirarkis Partner/Region/Branch/
  // MC/DSE "smooth transisinya"): dulu Ringkasan (leaderboard) CUMA
  // tampil kalau belum ada filter apa pun aktif - begitu 1 filter
  // kepencet, langsung lompat ke roster penuh, skip semua level
  // menengah. Sekarang Ringkasan tetap tampil SELAMA level yang sedang
  // dilihat (summaryGroupBy) BUKAN level terakhir ("dse") - "dse" =
  // level terakhir, langsung roster input/edit yang sudah ada (reuse,
  // tidak ada leaderboard dse terpisah lagi, lihat drillInto/HIERARCHY).
  const HIERARCHY = ["partner", "region", "branch", "mc", "dse"];
  const [summaryGroupBy, setSummaryGroupBy] = useState("partner"); // "partner" | "region" | "branch" | "mc" | "dse"
  // UPDATE (permintaan user - "kita bisa pilih ada rank by Total
  // penjualan, atau penjualan SP, atau penjualan Voucher / Penjualan
  // Saldo"): 1 state dipakai bareng oleh kolom Rank tabel ringkasan
  // drill-down & tabel Input DSE sekaligus (lihat RankMetricMenu).
  const [rankMetric, setRankMetric] = useState("total"); // "total" | "sp" | "voucher" | "saldo"
  const summaryGroupLabel = { partner: "Partner", region: "Region", branch: "Branch", mc: "MC", dse: "DSE" }[summaryGroupBy] || "Partner";
  // UPDATE (permintaan user - subtitle tanggal/bulan di tiap kolom
  // Penjualan tabel Ringkasan desktop): tanggal aktif (Daily) atau
  // "<Bulan> <Tahun>" (Full Month) - sama persis format yg dipakai label
  // period-nav di atas, cuma versi pendek "<Bulan> <Tahun>" tanpa tanggal
  // 1 nya utk mode Full Month.
  const periodColumnSubtitle = periodMode === "bulan"
    ? `${MONTH_NAMES[Number(calViewMonth.slice(5, 7)) - 1]} ${calViewMonth.slice(0, 4)}`
    : fmtDayMonth(entryDate);
  const hierarchyIdx = HIERARCHY.indexOf(summaryGroupBy);
  const showAllRegions = isSPM && summaryGroupBy !== "dse";
  // UPDATE (permintaan user - "pada half window atau full window itu
  // penjualan dan ar sejajar dengan pemilihan opsi tampilan partner/
  // region/branch/mc/dse"): sempat dipatok ke !isCardView (860) lalu
  // !isNarrowHeader (640), tapi user bilang di ~605px pun "harusnya
  // masih muat" digabung 1 baris - jadi dipakai breakpoint sendiri yg
  // lebih sempit (480px) khusus utk fitur gabung Tabs+toggle ini,
  // independen dari isCardView (tetap dipakai apa adanya utk render
  // tabel vs card data DSE/region) dan isNarrowHeader (dipakai apa
  // adanya utk urutan row periodnav).
  // UPDATE (permintaan user - screenshot level "DSE"/roster di layar
  // lebar: "bukannya seharusnya sudah tidak ada lagi urutan baris opsi
  // Penjualan DSE / AR DSE di urutan kedua... dia dikiri button opsi
  // Partner/Region/Branch/MC/DSE"): dulu digabung CUMA pas showAllRegions
  // (leaderboard) - begitu drill sampai level terakhir "dse" (roster),
  // showAllRegions jadi false dan baris gabungan ini ikut hilang, balik
  // ke Tabs underline terpisah di atas. Sekarang breadcrumb+toggle
  // (lihat kondisi render-nya di bawah) tampil di SEMUA level termasuk
  // roster, jadi baris gabungan Tabs+toggle ini juga harus ikut tampil
  // terus di semua level, bukan cuma pas showAllRegions.
  const showCombinedTabsToggle = width >= 560 && category === "dse" && (tab === "input" || tab === "ar") && isSPM;
  // UPDATE (permintaan user - "harusnya ada opsi untuk partner view dan
  // region view"): ringkasan tanpa filter apa pun sekarang bisa
  // dikelompokkan per Region (default, spt sebelumnya) ATAU per Partner,
  // dipilih lewat toggle "Region/Partner" di atas tabelnya.
  // UPDATE (permintaan user - "secara default jika dia memiliki akses ke
  // hirarki partner maka akan menampilkan partner, lalu jika salah satu
  // partner diklik, dia akan menuju ke tampilan region... begitu
  // selanjutnya... dan ini semua mengaktifkan filter sesuai yang dipilih,
  // sehingga smooth transisinya di Partner/Region/Branch/MC/DSE"): dulu
  // toggle Region/Partner/dst cuma ganti pengelompokan Ringkasan tanpa
  // nge-drill filter apa pun - sekarang jadi NAVIGASI HIRARKIS penuh:
  // default mulai di "partner", klik kartu/baris Ringkasan di level mana
  // pun otomatis set filter level itu KE value yang diklik SEKALIGUS
  // majuin summaryGroupBy ke level anaknya (lihat HIERARCHY/goToLevel &
  // onClick kartu Ringkasan) - jadi "DSE" (level terakhir) = full roster
  // input/edit yang sudah ada (bukan leaderboard dse terpisah), karena
  // lebih berguna utk entri data & tetap diurut dari penjualan tertinggi
  // (lihat effect sort default di bawah).
  const FILTER_SETTERS = { partner: setPartnerFilter, region: setRegionFilter, branch: setBranchFilter, mc: setMcFilter };
  // Majuin 1 level: set filter level SEKARANG ke `value` yang diklik, lalu
  // pindah ke level anaknya (dipakai onClick kartu/baris Ringkasan).
  const drillInto = (value) => runGuarded(() => {
    const lvl = HIERARCHY[hierarchyIdx];
    if (lvl === "dse") { setDseSearch(value); return; }
    FILTER_SETTERS[lvl]?.(value);
    if (hierarchyIdx < HIERARCHY.length - 1) applyGroupBy(HIERARCHY[hierarchyIdx + 1]);
  });
  // Lompat balik (breadcrumb): tampilkan daftar level `idx`, hapus filter
  // level `idx` dst (karena belum/tidak lagi dipilih), pertahankan filter
  // level2 SEBELUM `idx` (itu yg menyempitkan daftar yg ditampilkan).
  const goToLevel = (idx) => runGuarded(() => {
    for (let i = idx; i < HIERARCHY.length; i++) {
      const lvl = HIERARCHY[i];
      if (lvl === "dse") { setDseSearch(""); continue; }
      FILTER_SETTERS[lvl]?.("");
    }
    applyGroupBy(HIERARCHY[idx]);
  });
  // Breadcrumb trail: "Semua Partner" (reset total) lalu 1 chip per level
  // yang SUDAH dipilih (value filter-nya), masing2 bisa diklik utk balik
  // ke daftar anak level itu (lihat goToLevel).
  const drillBreadcrumbs = [
    { idx: 0, label: "Semua Partner", isHome: true },
    ...(partnerFilter ? [{ idx: 1, label: partnerFilter }] : []),
    ...(regionFilter ? [{ idx: 2, label: regionFilter }] : []),
    ...(branchFilter ? [{ idx: 3, label: branchFilter }] : []),
    ...(mcFilter ? [{ idx: 4, label: mcFilter }] : []),
  ];
  // Auto-scroll breadcrumb trail ke ujung kanan (crumb aktif/terakhir)
  // setiap kali path drill-down berubah, supaya di mobile crumb yang
  // sedang dipilih selalu kelihatan penuh, bukan terpotong.
  const breadcrumbScrollRef = useRef(null);
  useEffect(() => {
    const el = breadcrumbScrollRef.current;
    if (!el) return;
    const raf = requestAnimationFrame(() => {
      el.scrollLeft = el.scrollWidth;
    });
    return () => cancelAnimationFrame(raf);
  }, [partnerFilter, regionFilter, branchFilter, mcFilter, summaryGroupBy]);
  // Level terakhir (DSE) = roster input/edit yang sudah ada, BUKAN
  // leaderboard - selalu diurutkan dari penjualan/tunggakan tertinggi
  // ("walaupun diedit atau tidak, tetap mengurutkan dari penjualan
  // tertinggi") setiap kali landing di level ini (dipanggil langsung di
  // setiap tempat yg mengubah summaryGroupBy, bukan lewat effect, supaya
  // tidak memicu cascading render).
  const applyGroupBy = (lvl) => {
    setSummaryGroupBy(lvl);
    if (lvl === "dse") setSortConfig({ key: tab === "ar" ? "ar" : "totalPenjualan", dir: "desc" });
  };
  // UPDATE (permintaan user - "dibuat tetap satu line saja untuk summary
  // di awal, dan untuk tampilkan detail dia menjadi popup saja"): di
  // layar sempit (isCardView), Ringkasan MC SELALU cuma 2 kartu ringkas
  // 1 baris (Active/Vacant gabungan + Total Penjualan/Tunggakan, angka
  // format compact Jt/M) - detail lengkap (SP/Voucher/Saldo/Interview,
  // angka penuh) dibuka lewat POPUP (bottom-sheet) dari tombol "i", bukan
  // expand inline lagi. Di desktop semua kartu selalu tampil penuh (ga
  // kepengaruh state ini, popup juga ga dipakai).
  const [mcDetailOpen, setMcDetailOpen] = useState(false);
  const [heroCollapsed, setHeroCollapsed] = useState(() => (typeof window !== "undefined" ? window.innerWidth < 640 : false));
  // UPDATE (permintaan user - koreksi dari percobaan wrap-otomatis
  // sebelumnya: "maksud saya daily month dan picker datenya di row 2,
  // hanya tutup buka detail yang harus line 1"): BUKAN wrap kondisional
  // lagi (ResizeObserver dicoba sebelumnya lalu dicabut) - sekarang
  // SELALU 2 baris tetap di desktop: baris 1 = title + collapseBtn
  // (dseprod-header), baris 2 = Daily/Full Month + nav tanggal
  // (dseprod-controls-row), dipisah garis tipis permanen. Jauh lebih
  // simpel & pasti, ga ada lagi logic ukur lebar sama sekali.
  const loadRegionSummary = useCallback(async () => {
    setLoadingRegionSummary(true);
    try {
      // UPDATE (permintaan user - navigasi hirarkis Partner -> Region ->
      // Branch -> MC -> DSE): query dasar sekarang ikut disempitkan oleh
      // filter yang SUDAH aktif (persis pola cascading di loadDseAndEntries)
      // supaya mis. sesudah klik 1 Partner, Ringkasan Region yang tampil
      // CUMA region2 milik Partner itu, bukan seluruh Sumatera lagi.
      let dseQuery = supabase.from("mf_dse_database").select("dse_code, region, branch, mc, mdi, ds_name, dse_status").eq("is_revoked", false);
      if (partnerFilter) dseQuery = dseQuery.eq("mdi", partnerFilter);
      if (regionFilter) dseQuery = dseQuery.eq("region", regionFilter);
      if (branchFilter) dseQuery = dseQuery.eq("branch", branchFilter);
      if (mcFilter) dseQuery = dseQuery.eq("mc", mcFilter);
      const { data: dses, error: e1 } = await dseQuery;
      if (e1) throw e1;
      // UPDATE (permintaan user - "ubah pilihan tampilannya menjadi
      // Partner, Region, Branch, MC, DSE"): opsi "dse" beda sifatnya dari 4
      // lainnya - bukan rollup/grouping, tapi daftar PER-DSE individual
      // (1 "grup" = 1 DSE), kolom sama spt grouping lain, klik 1 baris
      // isi kotak search "Cari Kode DSE" (bukan set filter region/dst).
      const emptyLabelMap = { partner: "Belum Ada Partner", region: "Belum Ada Region", branch: "Belum Ada Branch", mc: "Belum Ada MC" };
      const emptyLabel = emptyLabelMap[summaryGroupBy] || "Belum Ada Region";
      const groupOf = {};
      const byGroup = {};
      (dses || []).forEach((r) => {
        const key = summaryGroupBy === "dse" ? r.dse_code
          : summaryGroupBy === "partner" ? (r.mdi || emptyLabel)
          : summaryGroupBy === "branch" ? (r.branch || emptyLabel)
          : summaryGroupBy === "mc" ? (r.mc || emptyLabel)
          : (r.region || emptyLabel);
        const label = summaryGroupBy === "dse" ? (r.ds_name || r.dse_code) : key;
        groupOf[r.dse_code] = key;
        // UPDATE (permintaan user - "akan menampilkan DSE Active /
        // Vacant (vacant warna merah jika ada jika 0 tetap hitam)"):
        // totalVacant ditambah persis spt pola mcSummary (lihat
        // r.dse_status === "Vacant" di useMemo mcSummary di bawah).
        if (!byGroup[key]) byGroup[key] = { key, label, totalAlokasi: 0, totalActive: 0, totalVacant: 0, qtySp: 0, nilaiSp: 0, qtyVoucher: 0, nilaiVoucher: 0, nilaiSaldo: 0, tunggakan: 0 };
        byGroup[key].totalAlokasi += 1;
        const effStatus = periodMode === "tanggal" ? resolveStatusAsOf(r.dse_code, entryDate, statusEvents, r.dse_status) : r.dse_status;
        if (effStatus === "Active") byGroup[key].totalActive += 1;
        else if (effStatus === "Vacant") byGroup[key].totalVacant += 1;
      });
      const codes = (dses || []).map((r) => r.dse_code);
      if (codes.length) {
        // UPDATE (permintaan user - "bisa daily / full month"): mode Full
        // Month (isRangeMode) sekarang diakumulasi dari SEMUA tanggal
        // tercentang (sortedSelectedDates), persis logic tabel input
        // (loadDseAndEntries) - Qty/Nilai SP/Voucher/Saldo dijumlah,
        // AR/Piutang dipakai dari baris tanggal TERAKHIR per dse_code
        // (bukan dijumlah, krn dia saldo bukan nilai kumulatif).
        // "Both" -> jumlahkan IM3 + 3ID sekaligus (ga difilter per-brand);
        // kalau cuma 1 brand aktif tetap difilter spt sebelumnya.
        let prodQuery = supabase.from("mf_dse_prod_ar").select("dse_code, tanggal, qty_sp, nilai_sp, qty_voucher, nilai_voucher, nilai_saldo, ar_piutang").in("dse_code", codes);
        prodQuery = isRangeMode ? prodQuery.in("tanggal", sortedSelectedDates).order("tanggal", { ascending: true }) : prodQuery.eq("tanggal", entryDate);
        const { data: prod, error: e2 } = await prodQuery;
        if (e2) throw e2;
        (prod || []).forEach((p) => {
          const g = byGroup[groupOf[p.dse_code]];
          if (!g) return;
          g.qtySp += fRaw(p.qty_sp); g.nilaiSp += fRaw(p.nilai_sp);
          g.qtyVoucher += fRaw(p.qty_voucher); g.nilaiVoucher += fRaw(p.nilai_voucher);
          g.nilaiSaldo += fRaw(p.nilai_saldo);
          g.tunggakan = isRangeMode ? fRaw(p.ar_piutang) : (g.tunggakan + fRaw(p.ar_piutang)); // range: baris terakhir menang (saldo, bukan kumulatif)
        });
      }
      // UPDATE (permintaan user - "setiap view yang dipilih dia akan
      // menyesuaikan ke penjualan terbanyak sesuai filter yang dipilih"):
      // diurutkan dari penjualan TERBESAR (tab Penjualan: Nilai SP +
      // Voucher + Saldo) atau tunggakan TERBESAR (tab AR) - bukan alfabet
      // lagi - biar region/partner/branch/mc/dse paling tinggi langsung
      // kelihatan di atas.
      // UPDATE (permintaan user - "kita bisa pilih ada rank by Total
      // penjualan, atau penjualan SP, atau penjualan Voucher / Penjualan
      // Saldo"): tab AR tetap diurutkan dari tunggakan terbesar (ga ada
      // pilihan metric di situ), tab Penjualan sekarang ikut rankMetric
      // yg dipilih lewat RankMetricMenu di header kolom Rank.
      const rankSortValue = (g) => (tab === "ar" ? g.tunggakan : rankMetricValueOf(g, rankMetric));
      setRegionSummary(Object.values(byGroup).sort((a, b) => rankSortValue(b) - rankSortValue(a) || a.label.localeCompare(b.label)));
      // (groupOf key dipakai di atas utk match produksi per dse_code;
      // key bisa = dse_code sendiri saat summaryGroupBy === "dse")
    } catch (e) {
      showToast(e.message || "Gagal memuat ringkasan.", "error");
    } finally {
      setLoadingRegionSummary(false);
    }
  }, [entryDate, summaryGroupBy, isRangeMode, sortedSelectedDates, tab, partnerFilter, regionFilter, branchFilter, mcFilter, periodMode, statusEvents, rankMetric]);

  // eslint-disable-next-line react-hooks/set-state-in-effect
  useEffect(() => { if (showAllRegions) loadRegionSummary(); }, [showAllRegions, loadRegionSummary]);

  const loadDseAndEntries = useCallback(async () => {
    setLoadingDse(true);
    try {
      let q = supabase.from("mf_dse_database").select("dse_code, dse_code_3id, ds_name, mc, branch, region, mdi, is_revoked, dse_status, join_date").eq("is_revoked", false).order("dse_code", { ascending: true });
      if (isSPM) {
        // Tanpa filter apa pun -> tampilkan akumulasi dari level tertinggi
        // (semua Partner/Region/Branch/MC), bukan kosong.
        if (regionFilter) q = q.eq("region", regionFilter);
        if (branchFilter) q = q.eq("branch", branchFilter);
        if (partnerFilter) q = q.eq("mdi", partnerFilter);
        if (mcFilter) q = q.eq("mc", mcFilter);
      }
      // Supabase caps a single request at 1000 rows -> paginate with
      // .range() so DSE lists past 1000 (ALL Sumatera akumulasi) aren't
      // silently truncated.
      const dses = [];
      const PAGE = 1000;
      for (let from = 0; ; from += PAGE) {
        const { data: pageData, error: eP } = await q.range(from, from + PAGE - 1);
        if (eP) throw eP;
        dses.push(...(pageData || []));
        if (!pageData || pageData.length < PAGE) break;
      }
      setDseList(dses);

      const codes = (dses || []).map((r) => r.dse_code);
      if (codes.length) {
        if (isRangeMode) {
          // Mode Periode: AKUMULASI tanggal-tanggal yg DICENTANG (bisa bolong,
          // tidak harus berurutan — spt filter tanggal di Excel). Qty/Nilai
          // SP/Voucher/Saldo -> dijumlahkan. AR/Piutang bukan nilai kumulatif
          // (dia saldo), jadi dipakai ar_piutang pada tanggal TERCENTANG yg
          // paling baru per dse_code+brand (bukan dijumlah).
          const { data: prod, error: e2 } = await supabase
            .from("mf_dse_prod_ar").select("*")
            .in("tanggal", sortedSelectedDates).in("dse_code", codes)
            .order("tanggal", { ascending: true });
          if (e2) throw e2;
          const map = {};
          const uploaderIds = new Set();
          (prod || []).forEach((r) => {
            const acc = map[r.dse_code] || {
              qty_sp: 0, nilai_sp: 0, qty_saldo: 0, nilai_saldo: 0, qty_voucher: 0, nilai_voucher: 0,
              ar_piutang: 0, ar_bayar: 0, catatan: "", updated_at: r.updated_at, uploaded_at: r.uploaded_at, uploaded_by: r.uploaded_by,
            };
            acc.qty_sp += fRaw(r.qty_sp); acc.nilai_sp += fRaw(r.nilai_sp);
            acc.qty_saldo += fRaw(r.qty_saldo); acc.nilai_saldo += fRaw(r.nilai_saldo);
            acc.qty_voucher += fRaw(r.qty_voucher); acc.nilai_voucher += fRaw(r.nilai_voucher);
            acc.ar_bayar += fRaw(r.ar_bayar);
            acc.ar_piutang = r.ar_piutang; // selalu ditimpa -> baris terakhir (tanggal paling baru) yg menang
            acc.updated_at = r.updated_at; acc.uploaded_at = r.uploaded_at; acc.uploaded_by = r.uploaded_by;
            map[r.dse_code] = acc;
            if (r.uploaded_by) uploaderIds.add(r.uploaded_by);
          });
          setEntries(map);
          setPrevAr({});
          if (uploaderIds.size) {
            const { data: profs } = await supabase.from("profiles").select("id, full_name").in("id", Array.from(uploaderIds));
            const pm = {};
            (profs || []).forEach((p) => { pm[p.id] = p.full_name; });
            setProfilesMap(pm);
          } else {
            setProfilesMap({});
          }
          setIdentity({});
          setDirty({});
          return;
        }

        // UPDATE (permintaan user - "saat saya melakukan filter loadinya
        // sangat lama, bagaimana kita improve kecepatannya"): 2 query di
        // bawah ini (entry hari ini & carry-forward AR sebelumnya) TIDAK
        // saling bergantung - dulu di-`await` satu-satu (serial, nambah 1
        // round-trip penuh ke Supabase per query), sekarang jalan BARENGAN
        // lewat Promise.all supaya waktu tunggunya cuma selama query yg
        // paling lambat, bukan dijumlah. Kolom yg di-select juga dipersempit
        // (dulu "*") supaya payload yg ditarik lebih kecil.
        const PROD_COLS = "dse_code, qty_sp, nilai_sp, qty_saldo, nilai_saldo, qty_voucher, nilai_voucher, ar_piutang, ar_bayar, catatan, updated_at, uploaded_at, uploaded_by";
        const [
          { data: prod, error: e2 },
          { data: prev, error: e3 },
        ] = await Promise.all([
          supabase.from("mf_dse_prod_ar").select(PROD_COLS).eq("tanggal", entryDate).in("dse_code", codes),
          // Carry-forward: ambil ar_piutang terakhir SEBELUM entryDate per
          // dse_code, utk ditampilkan sbg "Utang Saat Ini" (read-only) di
          // ArPiutangInput.
          supabase
            .from("mf_dse_prod_ar")
            .select("dse_code, ar_piutang, tanggal")
            .lt("tanggal", entryDate)
            .in("dse_code", codes)
            .order("tanggal", { ascending: false })
            .limit(5000),
        ]);
        if (e2) throw e2;
        if (e3) throw e3;
        const map = {};
        const uploaderIds = new Set();
        (prod || []).forEach((r) => {
          map[r.dse_code] = {
            qty_sp: r.qty_sp, nilai_sp: r.nilai_sp, qty_saldo: r.qty_saldo, nilai_saldo: r.nilai_saldo,
            qty_voucher: r.qty_voucher, nilai_voucher: r.nilai_voucher,
            ar_piutang: r.ar_piutang, ar_bayar: r.ar_bayar || 0, catatan: r.catatan || "",
            updated_at: r.updated_at, uploaded_at: r.uploaded_at, uploaded_by: r.uploaded_by,
          };
          if (r.uploaded_by) uploaderIds.add(r.uploaded_by);
        });
        setEntries(map);

        const prevMap = {};
        (prev || []).forEach((r) => {
          if (!(r.dse_code in prevMap)) prevMap[r.dse_code] = fRaw(r.ar_piutang);
        });
        setPrevAr(prevMap);

        if (uploaderIds.size) {
          const { data: profs } = await supabase.from("profiles").select("id, full_name").in("id", Array.from(uploaderIds));
          const pm = {};
          (profs || []).forEach((p) => { pm[p.id] = p.full_name; });
          setProfilesMap(pm);
        } else {
          setProfilesMap({});
        }
      } else {
        setEntries({});
        setPrevAr({});
        setProfilesMap({});
      }
      setIdentity({});
      setDirty({});
    } catch (e) {
      showToast(e.message || "Gagal memuat daftar DSE.", "error");
    } finally {
      setLoadingDse(false);
    }
  }, [isSPM, regionFilter, branchFilter, partnerFilter, mcFilter, entryDate, isRangeMode, sortedSelectedDates]);

  useEffect(() => { loadDseAndEntries(); }, [loadDseAndEntries]);

  // Bulk-load ar_piutang_items utk SEMUA dse_code yg lagi tampil, khusus
  // tab AR - dipakai cuma utk opsi/filter checklist kolom Total Piutang/
  // Total Dibayar/Status/Jatuh Tempo/Keterangan (lihat `arItemsAgg` di
  // atas). Query & agregasinya terpisah dari ArPiutangInput (yg tetap
  // fetch sendiri per-baris utk nilai yg ditampilkan di tabel) supaya
  // logic modal/list/edit piutang itu ga disentuh.
  useEffect(() => {
    if (tab !== "ar" || !dseList.length) { setArItemsAgg({}); return; }
    let cancelled = false;
    (async () => {
      const codes = dseList.map((r) => r.dse_code);
      const agg = {};
      const CHUNK = 500;
      try {
        for (let i = 0; i < codes.length; i += CHUNK) {
          const chunk = codes.slice(i, i + CHUNK);
          const { data, error } = await supabase.from("ar_piutang_items")
            .select("dse_code, total, jatuh_tempo, tanggal_transaksi, catatan, ar_piutang_payments(nominal)")
            .in("dse_code", chunk);
          if (error) throw error;
          (data || []).forEach((it) => {
            const a = agg[it.dse_code] || { totalPiutang: 0, totalDibayar: 0, unpaid: [] };
            const total = fRaw(it.total);
            const paid = (it.ar_piutang_payments || []).reduce((s, p) => s + fRaw(p.nominal), 0);
            a.totalPiutang += total;
            a.totalDibayar += paid;
            if (paid < total) a.unpaid.push({ jatuh_tempo: it.jatuh_tempo, catatan: it.catatan });
            agg[it.dse_code] = a;
          });
        }
      } catch {
        // Gagal diam-diam - filter kolom2 ini sekadar bantuan, data utama
        // tabel (ArPiutangInput per-baris) tetap jalan seperti biasa.
      }
      if (cancelled) return;
      const out = {};
      Object.keys(agg).forEach((code) => {
        const a = agg[code];
        const nearest = a.unpaid.filter((u) => u.jatuh_tempo).sort((x, y) => new Date(x.jatuh_tempo) - new Date(y.jatuh_tempo))[0] || null;
        out[code] = {
          totalPiutang: a.totalPiutang, totalDibayar: a.totalDibayar,
          lunas: a.unpaid.length === 0,
          jatuhTempo: nearest?.jatuh_tempo || "",
          keterangan: nearest?.catatan || "",
        };
      });
      setArItemsAgg(out);
    })();
    return () => { cancelled = true; };
  }, [tab, dseList]);

  // Warn before closing/reloading the tab while there are unsaved edits.
  useEffect(() => {
    const anyDirty = Object.values(dirty).some(Boolean);
    if (!anyDirty) return;
    const handler = (e) => { e.preventDefault(); e.returnValue = ""; return ""; };
    window.addEventListener("beforeunload", handler);
    return () => window.removeEventListener("beforeunload", handler);
  }, [dirty]);

  const handleEntryChange = (code, val) => {
    setEntries((prev) => ({ ...prev, [code]: val }));
    setDirty((prev) => ({ ...prev, [code]: true }));
  };
  const handleIdentityChange = (code, field, val) => {
    setIdentity((prev) => ({ ...prev, [code]: { ...prev[code], [field]: val } }));
    setDirty((prev) => ({ ...prev, [code]: true }));
  };

  // UPDATE (permintaan user - popup "Ganti Nama"/"Isi Nama" & konfirmasi
  // Vacant): kedua flow itu perlu nyimpen identitas (ds_name/join_date/
  // dse_status) seketika itu juga TANPA nunggu 1 siklus render ganjil -
  // kalau cuma panggil onIdentityChange() lalu LANGSUNG onSave() di baris
  // berikutnya, onSave yg dipanggil masih nutup (closure) state `identity`
  // dari render SAAT INI (setIdentity async, belum ke-apply), jadi field
  // yg baru ditandai (mis. dse_status "Vacant") malah KELEWAT di payload.
  // Makanya handleSaveDse skrg terima `overridePatch` opsional - di-merge
  // LANGSUNG ke idEdit di sini (bukan lewat state), jadi payload PASTI
  // ikut nilai terbaru walau onIdentityChange() blm sempat ke-apply.
  const handleSaveDse = async (code, overridePatch) => {
    setSavingCode(code);
    try {
      const dse = dseList.find((x) => x.dse_code === code);
      const idEdit = overridePatch ? { ...identity[code], ...overridePatch } : identity[code];
      if (idEdit && (idEdit.ds_name !== undefined || idEdit.mc !== undefined || idEdit.dse_status !== undefined || idEdit.join_date !== undefined)) {
        const payload = {};
        if (idEdit.ds_name !== undefined && idEdit.ds_name !== dse?.ds_name) payload.ds_name = idEdit.ds_name;
        if (idEdit.mc !== undefined && idEdit.mc !== dse?.mc) payload.mc = idEdit.mc;
        if (idEdit.dse_status !== undefined && idEdit.dse_status !== dse?.dse_status) payload.dse_status = idEdit.dse_status || null;
        if (idEdit.join_date !== undefined && idEdit.join_date !== dse?.join_date) payload.join_date = idEdit.join_date || null;
        if (Object.keys(payload).length) {
          const { error } = await supabase.from("mf_dse_database").update(payload).eq("dse_code", code);
          if (error) throw error;
          // UPDATE (status per tanggal): kalau status DSE ini ikut diubah,
          // refresh index riwayat status (statusEvents) biar counting
          // Active/Vacant di Ringkasan langsung akurat tanpa perlu reload
          // halaman - trigger DB sudah nyatet baris history-nya duluan
          // (synchronous, dalam transaksi UPDATE yg sama).
          if (payload.dse_status !== undefined) loadStatusEvents();
        }
      }

      const e = entries[code];
      if (e) {
        const row = {
          tanggal: entryDate, dse_code: code,
          mc: (idEdit?.mc ?? dse?.mc) || null,
          qty_sp: fRaw(e.qty_sp), nilai_sp: fRaw(e.nilai_sp),
          qty_saldo: fRaw(e.qty_saldo), nilai_saldo: fRaw(e.nilai_saldo),
          qty_voucher: fRaw(e.qty_voucher), nilai_voucher: fRaw(e.nilai_voucher),
          ar_piutang: fRaw(e.ar_piutang), ar_bayar: fRaw(e.ar_bayar), catatan: e.catatan || null,
          uploaded_by: profile?.id || null,
        };
        const { error } = await supabase.from("mf_dse_prod_ar").upsert([row], { onConflict: "tanggal,dse_code" });
        if (error) throw error;
      }
      setDirty((prev) => ({ ...prev, [code]: false }));
      showToast(`Data ${code} tersimpan.`, "ok");
      return true;
    } catch (e) {
      showToast(e.message || "Gagal menyimpan.", "error");
      return false;
    } finally {
      setSavingCode(null);
    }
  };

  const handleSaveAllDirty = async () => {
    const codes = Object.keys(dirty).filter((c) => dirty[c]);
    const results = [];
    for (const c of codes) results.push(await handleSaveDse(c)); // eslint-disable-line no-await-in-loop
    const failCount = results.filter((r) => r === false).length;
    if (failCount === 0 && codes.length > 0) {
      showToast(`Semua perubahan tersimpan dengan aman (${codes.length} DSE).`, "ok");
    } else if (failCount > 0) {
      showToast(`${codes.length - failCount} dari ${codes.length} DSE tersimpan. ${failCount} gagal, silakan coba lagi.`, "error");
    }
    return failCount === 0;
  };

  // --- Unsaved-changes guard: any action that would discard in-progress edits
  // (switching tab, changing region/branch/partner/MC/brand filters, or
  // changing the period) must first confirm Save or Discard with the user.
  const [pendingGuardedAction, setPendingGuardedAction] = useState(null); // () => void
  const runGuarded = (action) => {
    if (Object.values(dirty).some(Boolean)) {
      setPendingGuardedAction(() => action);
    } else {
      action();
    }
  };
  const discardAllDirty = () => {
    setDirty({});
    setEntries({});
    setIdentity({});
    loadDseAndEntries();
  };
  const handleConfirmSave = async () => {
    const action = pendingGuardedAction;
    const ok = await handleSaveAllDirty();
    if (ok) {
      setPendingGuardedAction(null);
      if (action) action();
    }
  };
  const handleConfirmDiscard = () => {
    const action = pendingGuardedAction;
    discardAllDirty();
    setPendingGuardedAction(null);
    if (action) action();
  };

  // Enrich dulu (nilai yg LAGI TAMPIL, termasuk editan blm tersimpan,
  // dijumlahkan lintas activeBrands kalau mode IOH - match persis logic
  // mcSummary/stat tile) - dipakai bareng utk bangun opsi checklist tiap
  // ExcelFilter (Select All dari nilai yg BENERAN ada di data) & utk filter
  // + sort (Asc/Desc) itu sendiri.
  const enrichedDse = useMemo(() => dseList.map((r) => {
    const namaVal = identity[r.dse_code]?.ds_name ?? r.ds_name ?? "";
    const statusVal = identity[r.dse_code]?.dse_status ?? r.dse_status ?? "";
    const joinVal = identity[r.dse_code]?.join_date ?? r.join_date ?? "";
    const partnerVal = r.mdi ?? "";
    const regionVal = r.region ?? "";
    const branchVal = r.branch ?? "";
    const e = entries[r.dse_code];
    const nilaiSp = fRaw(e?.nilai_sp);
    const nilaiVoucher = fRaw(e?.nilai_voucher);
    const nilaiSaldo = fRaw(e?.nilai_saldo);
    const catatanAll = (e?.catatan || "").trim();
    const ar = fRaw(prevAr[r.dse_code]);
    const totalPenjualan = nilaiSp + nilaiVoucher + nilaiSaldo;
    const agg = arItemsAgg[r.dse_code];
    const totalPiutangVal = agg ? agg.totalPiutang : 0;
    const totalDibayarVal = agg ? agg.totalDibayar : 0;
    const arStatusVal = agg ? (agg.lunas ? "lunas" : "belum_lunas") : "lunas";
    const jatuhTempoVal = agg?.jatuhTempo || "";
    const arKeteranganVal = agg?.keterangan || "";
    return { r, namaVal, statusVal, joinVal, partnerVal, regionVal, branchVal, nilaiSp, nilaiVoucher, nilaiSaldo, totalPenjualan, ar, catatanAll, totalPiutangVal, totalDibayarVal, arStatusVal, jatuhTempoVal, arKeteranganVal };
  }), [dseList, identity, entries, prevAr, arItemsAgg]);

  // Opsi checklist tiap kolom (distinct values dari enrichedDse saat ini).
  const colOptions = useMemo(() => {
    const uniq = (vals, fmt) => [...new Set(vals)].sort((a, b) => (a > b ? 1 : a < b ? -1 : 0))
      .map((v) => ({ value: v, label: fmt ? fmt(v) : (v === "" ? "— Kosong —" : String(v)) }));
    return {
      id: uniq(enrichedDse.map((x) => x.r.dse_code)),
      partner: uniq(enrichedDse.map((x) => x.partnerVal)),
      region: uniq(enrichedDse.map((x) => x.regionVal)),
      branch: uniq(enrichedDse.map((x) => x.branchVal)),
      nama: uniq(enrichedDse.map((x) => x.namaVal)),
      status: STATUS_OPTIONS.map((s) => ({ value: s.v, label: s.label })),
      join: uniq(enrichedDse.map((x) => x.joinVal), (v) => (v ? fmtLongDate(v) : "— Kosong —")),
      totalSp: uniq(enrichedDse.map((x) => x.nilaiSp), (v) => `Rp ${fmtID(v)}`),
      totalVoucher: uniq(enrichedDse.map((x) => x.nilaiVoucher), (v) => `Rp ${fmtID(v)}`),
      saldo: uniq(enrichedDse.map((x) => x.nilaiSaldo), (v) => `Rp ${fmtID(v)}`),
      totalPenjualan: uniq(enrichedDse.map((x) => x.totalPenjualan), (v) => `Rp ${fmtID(v)}`),
      ar: uniq(enrichedDse.map((x) => x.ar), (v) => `Rp ${fmtID(v)}`),
      catatan: uniq(enrichedDse.map((x) => x.catatanAll)),
      totalPiutang: uniq(enrichedDse.map((x) => x.totalPiutangVal), (v) => `Rp ${fmtID(v)}`),
      totalDibayar: uniq(enrichedDse.map((x) => x.totalDibayarVal), (v) => `Rp ${fmtID(v)}`),
      arStatus: [{ value: "lunas", label: "Lunas" }, { value: "belum_lunas", label: "Belum Lunas" }],
      jatuhTempo: uniq(enrichedDse.map((x) => x.jatuhTempoVal), (v) => (v ? fmtDayMonth(v) : "— Kosong —")),
      arKeterangan: uniq(enrichedDse.map((x) => x.arKeteranganVal)),
    };
  }, [enrichedDse]);

  const filteredDseList = useMemo(() => {
    let out = enrichedDse.filter((x) => {
      const { r } = x;
      if (dseSearch) {
        const s = dseSearch.toLowerCase();
        if (!(r.dse_code?.toLowerCase().includes(s) || r.dse_code_3id?.toLowerCase().includes(s) || r.ds_name?.toLowerCase().includes(s))) return false;
      }
      if (colFilters.id.length && !colFilters.id.includes(r.dse_code)) return false;
      if (colFilters.partner.length && !colFilters.partner.includes(x.partnerVal)) return false;
      if (colFilters.region.length && !colFilters.region.includes(x.regionVal)) return false;
      if (colFilters.branch.length && !colFilters.branch.includes(x.branchVal)) return false;
      if (colFilters.nama.length && !colFilters.nama.includes(x.namaVal)) return false;
      if (colFilters.status.length && !colFilters.status.includes(x.statusVal)) return false;
      if (colFilters.join.length && !colFilters.join.includes(x.joinVal)) return false;
      if (colFilters.totalSp.length && !colFilters.totalSp.includes(x.nilaiSp)) return false;
      if (colFilters.totalVoucher.length && !colFilters.totalVoucher.includes(x.nilaiVoucher)) return false;
      if (colFilters.saldo.length && !colFilters.saldo.includes(x.nilaiSaldo)) return false;
      if (colFilters.totalPenjualan.length && !colFilters.totalPenjualan.includes(x.totalPenjualan)) return false;
      if (colFilters.ar.length && !colFilters.ar.includes(x.ar)) return false;
      if (colFilters.catatan.length && !colFilters.catatan.includes(x.catatanAll)) return false;
      if (colFilters.totalPiutang.length && !colFilters.totalPiutang.includes(x.totalPiutangVal)) return false;
      if (colFilters.totalDibayar.length && !colFilters.totalDibayar.includes(x.totalDibayarVal)) return false;
      if (colFilters.arStatus.length && !colFilters.arStatus.includes(x.arStatusVal)) return false;
      if (colFilters.jatuhTempo.length && !colFilters.jatuhTempo.includes(x.jatuhTempoVal)) return false;
      if (colFilters.arKeterangan.length && !colFilters.arKeterangan.includes(x.arKeteranganVal)) return false;
      return true;
    });

    if (sortConfig.key && sortConfig.dir) {
      const dir = sortConfig.dir === "asc" ? 1 : -1;
      const valueOf = (x) => {
        switch (sortConfig.key) {
          case "id": return x.r.dse_code || "";
          case "partner": return x.partnerVal || "";
          case "region": return x.regionVal || "";
          case "branch": return x.branchVal || "";
          case "nama": return x.namaVal || "";
          case "status": return x.statusVal || "";
          case "join": return x.joinVal || "";
          case "totalSp": return x.nilaiSp;
          case "totalVoucher": return x.nilaiVoucher;
          case "saldo": return x.nilaiSaldo;
          case "totalPenjualan": return x.totalPenjualan;
          case "ar": return x.ar;
          case "catatan": return x.catatanAll || "";
          case "totalPiutang": return x.totalPiutangVal;
          case "totalDibayar": return x.totalDibayarVal;
          case "arStatus": return x.arStatusVal || "";
          case "jatuhTempo": return x.jatuhTempoVal || "";
          case "arKeterangan": return x.arKeteranganVal || "";
          default: return "";
        }
      };
      out = [...out].sort((a, b) => {
        const va = valueOf(a), vb = valueOf(b);
        if (typeof va === "string" || typeof vb === "string") return String(va).localeCompare(String(vb)) * dir;
        return (va - vb) * dir;
      });
    } else if (tab !== "ar") {
      // UPDATE (permintaan user - "jadi diurutkan berdasarkan total
      // penjualan" + "kita bisa pilih ada rank by Total penjualan, atau
      // penjualan SP, atau penjualan Voucher / Penjualan Saldo"): default
      // (belum ada sort manual lewat ExcelFilter) urutannya ikut
      // rankMetric yg dipilih lewat RankMetricMenu di header kolom Rank,
      // dipasangkan dgn kolom Rank di paling kiri tabel. Khusus tab AR,
      // kolom Total Penjualan ga relevan/ga ditampilkan - urutan default
      // tetap apa adanya.
      out = [...out].sort((a, b) => rankMetricValueOf(b, rankMetric) - rankMetricValueOf(a, rankMetric));
    }

    return out.map((x) => x.r);
  }, [enrichedDse, dseSearch, colFilters, sortConfig, tab, rankMetric]);
  // ── Ringkasan (summary cards) — di-scope ke MC yang sedang dipilih (lihat
  // `dseList`, bukan filteredDseList, supaya tetap utuh walau sedang mengetik
  // di kotak "Cari DSE") + brand & tanggal yang aktif saat ini. Status DSE
  // dan angka yg BARU DIEDIT (belum disimpan ke server) ikut dihitung di sini
  // juga - pakai `identity`/`entries` override yg sama dgn yg dipakai baris
  // tabel, supaya kartu ini langsung update real-time saat admin mengetik,
  // bukan baru berubah setelah tombol Simpan ditekan.
  // UPDATE (permintaan user): akumulasi per Branch & per Partner MENYUSUL -
  // utk sekarang summary-nya cuma per MC yg sedang dipilih di filter atas.
  const mcSummary = useMemo(() => {
    let totalActive = 0, totalVacant = 0, totalInterview = 0;
    let qtySp = 0, nilaiSp = 0, qtyVoucher = 0, nilaiVoucher = 0, nilaiSaldo = 0, tunggakan = 0, totalDibayar = 0;
    for (const dse of dseList) {
      const liveStatus = identity[dse.dse_code]?.dse_status ?? dse.dse_status ?? "";
      // UPDATE (status per tanggal): mode Daily (tanggal spesifik, bukan
      // hari ini) -> rekonstruksi status dari riwayat (resolveStatusAsOf).
      // Mode Full Month / hari ini -> tetap status LIVE (termasuk draft
      // editan blm disimpan, spt sebelumnya) biar real-time saat ngetik.
      const status = periodMode === "tanggal" ? resolveStatusAsOf(dse.dse_code, entryDate, statusEvents, liveStatus) : liveStatus;
      if (status === "Active") totalActive++;
      else if (status === "Vacant") totalVacant++;
      else if (status === "Interview") totalInterview++;
      const e = entries[dse.dse_code];
      if (e) {
        qtySp += fRaw(e.qty_sp); nilaiSp += fRaw(e.nilai_sp);
        qtyVoucher += fRaw(e.qty_voucher); nilaiVoucher += fRaw(e.nilai_voucher);
        nilaiSaldo += fRaw(e.nilai_saldo);
        tunggakan += fRaw(e.ar_piutang);
        totalDibayar += fRaw(e.ar_bayar);
      }
    }
    // UPDATE (permintaan user - "Total Piutang | Total Dibayar | Sisa
    // Piutang, cardnya seperti ini juga"): StatTiles tab AR sekarang
    // menambahkan Total Piutang & Total Dibayar di samping Sisa Piutang
    // (tunggakan) yg sudah ada, pakai label/urutan sama persis dgn kolom
    // tabel yg baru (Total Piutang, Total Dibayar, Sisa Piutang). Dihitung
    // dari cache mf_dse_prod_ar yg SAMA dgn yg sudah dipakai `tunggakan`
    // (entries[dse].ar_piutang = sisa, ar_bayar = dibayar HARI INI) - bukan
    // query baru ke ar_piutang_items per-DSE (terlalu berat utk summary
    // page-level) - totalPiutang = sisa + dibayar (identitas akuntansi
    // harian: piutang hari ini = sisa yg belum dibayar + yg sudah dibayar).
    const totalPiutang = tunggakan + totalDibayar;
    return { totalAlokasi: dseList.length, totalActive, totalVacant, totalInterview, qtySp, nilaiSp, qtyVoucher, nilaiVoucher, nilaiSaldo, tunggakan, totalDibayar, totalPiutang, totalPenjualan: nilaiSp + nilaiVoucher + nilaiSaldo };
  }, [dseList, identity, entries, periodMode, entryDate, statusEvents]);

  // UPDATE (permintaan user - "harusnya angkanya saja yang loading namun
  // summary card placeholdernya selalu ada"): shell kartu Ringkasan (ikon,
  // label "Active / Vacant", "Total Penjualan", border/background) SELALU
  // tampil dari awal render - cuma angka di dalamnya yang diganti jadi
  // skeleton pulsing (NumSkeleton) selama load PERTAMA kali (loadingDse
  // && dseList masih kosong), biar ga ada layout-shift / spinner generik
  // yang nutupin seluruh kartu seperti sebelumnya.
  const isSummaryLoading = loadingDse && dseList.length === 0;

  // ── Import massal Excel (opsional, sekunder) ──────────────────────────────
  const [staged, setStaged] = useState(null);
  const [uploading, setUploading] = useState(false);
  const fileRef = useRef(null);
  const onPickFile = async (fileList) => {
    const f = (fileList || [])[0];
    if (!f) return;
    const p = await parseWorkbook(f, isMPX ? (mpxMcFilter || lockedMc) : mcFilter);
    setStaged({ fileName: f.name, ...p });
    if (fileRef.current) fileRef.current.value = "";
  };
  const handleUpload = async () => {
    if (!staged || staged.error || !staged.rows?.length) return;
    setUploading(true);
    try {
      const payload = staged.rows.map((r) => ({ ...r, uploaded_by: profile?.id || null, source_file: staged.fileName }));
      const { error } = await supabase.from("mf_dse_prod_ar").upsert(payload, { onConflict: "tanggal,dse_code" });
      if (error) throw error;
      showToast(`Berhasil disimpan — ${payload.length} baris.`, "ok");
      setStaged(null);
      loadDseAndEntries();
      fetchRiwayat(1, search);
    } catch (e) {
      showToast(e.message || "Gagal menyimpan data.", "error");
    } finally {
      setUploading(false);
    }
  };

  // ── Tab "Riwayat" ──────────────────────────────────────────────────────────
  const [rows, setRows] = useState([]);
  const [total, setTotal] = useState(0);
  const [page, setPage] = useState(1);
  const [fetching, setFetching] = useState(false);
  const [search, setSearch] = useState("");
  const [searchInput, setSearchInput] = useState("");
  const [dateFrom, setDateFrom] = useState("");
  const [dateTo, setDateTo] = useState("");
  const [totals, setTotals] = useState({ qty_sp: 0, nilai_sp: 0, qty_saldo: 0, nilai_saldo: 0, qty_voucher: 0, nilai_voucher: 0, ar_piutang: 0, ar_bayar: 0 });
  const [exportLoading, setExportLoading] = useState(false);
