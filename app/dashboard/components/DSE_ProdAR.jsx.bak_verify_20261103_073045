const statusEventDate = (ts) => new Date(ts).toISOString().slice(0, 10);
function resolveStatusAsOf(dseCode, dateStr, statusEvents, liveStatus) {
  // Hari ini (atau tanggal "masa depan" yg ga mungkin dipilih krn nav
  // dibatasi) -> status LIVE apa adanya, ga perlu rekonstruksi riwayat.
  if (!dateStr || dateStr >= todayISO()) return liveStatus;
  const events = statusEvents?.[dseCode];
  if (!events || events.length === 0) return liveStatus; // belum pernah ganti status -> status skrg berlaku dari dulu
  let result = null;
  for (const e of events) {
    if (e.date <= dateStr) result = e.new_value; // events terurut ASC by date
    else break;
  }
  if (result !== null) return result || "";
  // Semua perubahan tercatat terjadi SETELAH tanggal yg diminta -> status
  // pada tanggal itu = status SEBELUM perubahan tercatat paling awal.
  return events[0].old_value || liveStatus;
}
