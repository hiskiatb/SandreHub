        if (error) { setDisabledMonthsMap(new Map()); return; }
        const map = new Map();
        (data || []).forEach(r => {
          const key = `${r.partner_name}|${r.branch_name}|${r.mpc_mp3}|${String(r.year)}`;
          if (!map.has(key)) map.set(key, new Set());
