const babel = require("@babel/core");
const fs = require("fs");
const files = ["app/dashboard/components/PNL_SummaryV2.jsx", "app/dashboard/page.jsx"];
files.forEach((file) => {
  const code = fs.readFileSync(file, "utf-8");
  try {
    babel.transform(code, { filename: file, presets: ["next/babel"] });
    console.log(file, "PARSE_OK");
  } catch (e) {
    console.log(file, "PARSE_FAIL:", e.message);
  }
});
