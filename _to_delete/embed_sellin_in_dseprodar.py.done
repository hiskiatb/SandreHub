import re

path = "app/dashboard/components/DSE_ProdAR.jsx"
with open(path, "r", encoding="utf-8") as f:
    src = f.read()
orig = src

def do(old, new, n=1, label=""):
    global src
    c = src.count(old)
    assert c == n, f"[{label}] expected {n} occurrence(s), found {c}"
    src = src.replace(old, new)

# 1) Import komponen upload (dipakai di dalam modal popup, bukan halaman terpisah lagi -
#    permintaan user: "buat langsung disini saja untuk perbandingannya")
do(
    'import { createPortal } from "react-dom";',
    'import { createPortal } from "react-dom";\nimport AdminDseSellinCompare from "./AdminDseSellinCompare"; // BARU (permintaan user - upload & bandingkan sellin DSE LANGSUNG di layar Prod & AR ini, bukan menu terpisah)',
    label="import AdminDseSellinCompare",
)

# 2) State: buka/tutup modal upload+compare
do(
    '  const [regionSummary, setRegionSummary] = useState([]);',
    '  const [regionSummary, setRegionSummary] = useState([]);\n'
    '  // BARU (permintaan user - "buat langsung disini saja untuk perbandingannya", '
    '"jadi tetap bisa dilihat dari leaderboard partner region", "export as xlsx"): '
    'modal upload (AdminDseSellinCompare) + flag "ada data upload utk periode ini" '
    '(dipakai nentuin kolom tampilin angka vs dash "–") + map total per DSE (dipakai '
    'baik utk agregasi leaderboard maupun nantinya level DSE).\n'
    '  const [sellinCompareOpen, setSellinCompareOpen] = useState(false);\n'
    '  const [sellinUploadAvailable, setSellinUploadAvailable] = useState(false);',
    label="state sellinCompareOpen",
)

# 3) byGroup init: tambah field uploadSp/uploadVou/uploadSaldo
do(
    'if (!byGroup[key]) byGroup[key] = { key, label, totalAlokasi: 0, totalActive: 0, totalVacant: 0, qtySp: 0, nilaiSp: 0, nilaiFwa: 0, qtyVoucher: 0, nilaiVoucher: 0, nilaiSaldo: 0, tunggakan: 0, totalPiutang: 0, totalDibayar: 0 };',
    'if (!byGroup[key]) byGroup[key] = { key, label, totalAlokasi: 0, totalActive: 0, totalVacant: 0, qtySp: 0, nilaiSp: 0, nilaiFwa: 0, qtyVoucher: 0, nilaiVoucher: 0, nilaiSaldo: 0, tunggakan: 0, totalPiutang: 0, totalDibayar: 0, uploadSp: 0, uploadVou: 0, uploadSaldo: 0 };',
    label="byGroup init upload fields",
)

# 4) Fetch mf_dse_admin_sellin_upload & agregasi per group, persis sesudah blok
#    fetch mf_dse_prod_ar (tab "input" only - upload sellin cuma relevan di
#    Penjualan, bukan AR/Piutang).
anchor4 = '''          g.qtySp += fRaw(p.qty_sp); g.nilaiSp += fRaw(p.nilai_sp); g.nilaiFwa += fRaw(p.nilai_fwa);
          g.qtyVoucher += fRaw(p.qty_voucher); g.nilaiVoucher += fRaw(p.nilai_voucher);
          g.nilaiSaldo += fRaw(p.nilai_saldo);
          g.tunggakan = isRangeMode ? fRaw(p.ar_piutang) : (g.tunggakan + fRaw(p.ar_piutang)); // range: baris terakhir menang (saldo, bukan kumulatif)
        });
      }'''
new4 = anchor4 + '''
      // BARU (permintaan user - "jadi tetap bisa dilihat dari leaderboard
      // partner region ataupun di level dsenya, walaupun belum diupload
      // sediakan kolomnya"): agregasi total upload admin (mf_dse_admin_
      // sellin_upload, diisi lewat modal "Upload Sellin DSE" di tombol
      // header) per GROUP yg sedang ditampilkan - dipakai kolom "Sellin
      // Upload"/"Selisih" di tabel Ringkasan. Cuma relevan di tab
      // Penjualan (bukan AR/Piutang), & cuma utk periode BULAN PENUH yg
      // lagi dilihat (data upload memang snapshot kumulatif 1 bulan,
      // bukan per-tanggal).
      if (tab === "input") {
        const uploadPeriod = calViewMonth.slice(0, 7);
        let anyUploadRow = false;
        const UP_CHUNK = 500;
        for (let i = 0; i < codes.length; i += UP_CHUNK) {
          const chunk = codes.slice(i, i + UP_CHUNK);
          const { data: upRows, error: eUp } = await supabase
            .from("mf_dse_admin_sellin_upload")
            .select("dse_code, sellin_sp, sellin_vou, sellin_saldo")
            .eq("period", uploadPeriod).eq("matched", true).in("dse_code", chunk);
          if (eUp) { console.error("gagal muat mf_dse_admin_sellin_upload:", eUp); continue; }
          (upRows || []).forEach((u) => {
            const g = byGroup[groupOf[u.dse_code]];
            if (!g) return;
            anyUploadRow = true;
            g.uploadSp += fRaw(u.sellin_sp); g.uploadVou += fRaw(u.sellin_vou); g.uploadSaldo += fRaw(u.sellin_saldo);
          });
        }
        if (reqId === regionSummaryReqRef.current) setSellinUploadAvailable(anyUploadRow);
      }'''
do(anchor4, new4, label="fetch mf_dse_admin_sellin_upload")

# 5) Header grid: ubah lebar kolom (8 -> 10 kolom utk tab input) + tambah 2 header baru
old5 = '<div style={{ display: "grid", gridTemplateColumns: tab === "ar" ? "44px 1.5fr 1fr 1fr 1fr 1fr" : "44px 1.5fr 1fr 1fr 1fr 1fr 1fr 1fr", gap: 0, padding: "11px 18px", background: t.sub, fontSize: 10.5, fontWeight: 600, color: t.mid, textTransform: "uppercase", letterSpacing: 0.3 }}>'
new5 = '<div style={{ display: "grid", gridTemplateColumns: tab === "ar" ? "44px 1.5fr 1fr 1fr 1fr 1fr" : "44px 1.3fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr", gap: 0, padding: "11px 18px", background: t.sub, fontSize: 10.5, fontWeight: 600, color: t.mid, textTransform: "uppercase", letterSpacing: 0.3 }}>'
do(old5, new5, label="header gridTemplateColumns")

# 6) Row grid: SAMA persis (lebar kolom harus identik dgn header)
old6 = 'style={{ display: "grid", gridTemplateColumns: tab === "ar" ? "44px 1.5fr 1fr 1fr 1fr 1fr" : "44px 1.5fr 1fr 1fr 1fr 1fr 1fr 1fr", gap: 0, padding: "14px 18px", borderTop: i === 0 ? "none" : `1px solid ${t.line}`, cursor: "pointer", fontSize: 13, fontVariantNumeric: "tabular-nums", transition: "background 0.12s", background: i === 0 ? t.tealBg : "transparent" }}'
new6 = 'style={{ display: "grid", gridTemplateColumns: tab === "ar" ? "44px 1.5fr 1fr 1fr 1fr 1fr" : "44px 1.3fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr", gap: 0, padding: "14px 18px", borderTop: i === 0 ? "none" : `1px solid ${t.line}`, cursor: "pointer", fontSize: 13, fontVariantNumeric: "tabular-nums", transition: "background 0.12s", background: i === 0 ? t.tealBg : "transparent" }}'
do(old6, new6, label="row gridTemplateColumns")

# 7) Header: tambah 2 kolom baru "Sellin Upload" & "Selisih" PERSIS sesudah header
#    Rank-metric map (penutup blok tab!=="ar" header columns).
old7 = '''                        {["sp", "fwa", "voucher", "saldo", "total"].map((v) => RANK_METRIC_OPTIONS.find((o) => o.v === v)).map((opt) => (
                          <button key={opt.v} type="button" onClick={() => setRankMetric(opt.v)} title={`Urutkan Rank berdasarkan ${opt.label}`}
                            style={{ textAlign: "right", display: "flex", flexDirection: "column", alignItems: "flex-end", justifyContent: "center", background: "none", border: "none", padding: 0, cursor: "pointer", fontFamily: FONT, color: rankMetric === opt.v ? t.teal : t.mid }}>
                            <span style={{ display: "flex", alignItems: "center", gap: 3, fontSize: 10.5, fontWeight: 600, textTransform: "uppercase", letterSpacing: 0.3 }}>
                              <ArrowUpDown size={10} />
                              {opt.label}
                            </span>
                            <span style={{ fontWeight: 400, textTransform: "none", letterSpacing: 0, color: t.lo, marginTop: 1, fontSize: 10.5 }}>{periodColumnSubtitle}</span>
                          </button>
                        ))}
                      </>
                    )}
                  </div>'''
new7 = '''                        {["sp", "fwa", "voucher", "saldo", "total"].map((v) => RANK_METRIC_OPTIONS.find((o) => o.v === v)).map((opt) => (
                          <button key={opt.v} type="button" onClick={() => setRankMetric(opt.v)} title={`Urutkan Rank berdasarkan ${opt.label}`}
                            style={{ textAlign: "right", display: "flex", flexDirection: "column", alignItems: "flex-end", justifyContent: "center", background: "none", border: "none", padding: 0, cursor: "pointer", fontFamily: FONT, color: rankMetric === opt.v ? t.teal : t.mid }}>
                            <span style={{ display: "flex", alignItems: "center", gap: 3, fontSize: 10.5, fontWeight: 600, textTransform: "uppercase", letterSpacing: 0.3 }}>
                              <ArrowUpDown size={10} />
                              {opt.label}
                            </span>
                            <span style={{ fontWeight: 400, textTransform: "none", letterSpacing: 0, color: t.lo, marginTop: 1, fontSize: 10.5 }}>{periodColumnSubtitle}</span>
                          </button>
                        ))}
                        {/* BARU (permintaan user - "jadi tetap bisa dilihat
                            dari leaderboard partner region ... walaupun
                            belum diupload sediakan kolomnnya"): 2 kolom
                            tambahan dari data upload admin (mf_dse_admin_
                            sellin_upload) - selalu tampil (bukan cuma pas
                            ada datanya), isinya "–" kalau belum ada upload
                            utk periode bulan yg lagi dilihat. */}
                        <div style={{ textAlign: "right", display: "flex", alignItems: "center", justifyContent: "flex-end", height: "100%" }}>Sellin Upload</div>
                        <div style={{ textAlign: "right", display: "flex", alignItems: "center", justifyContent: "flex-end", height: "100%" }}>Selisih</div>
                      </>
                    )}
                  </div>'''
do(old7, new7, label="header kolom baru")

# 8) Row data: tambah 2 cell baru PERSIS sesudah cell "Total Penjualan".
old8 = '''                          <div style={{ textAlign: "right", fontWeight: 800, color: t.teal }}>Rp {fmtID(r.nilaiSp + r.nilaiFwa + r.nilaiVoucher + r.nilaiSaldo)}</div>
                        </>
                      )}
                    </div>
                  ))}'''
new8 = '''                          <div style={{ textAlign: "right", fontWeight: 800, color: t.teal }}>Rp {fmtID(r.nilaiSp + r.nilaiFwa + r.nilaiVoucher + r.nilaiSaldo)}</div>
                          {/* BARU (permintaan user - upload sellin admin vs
                              penjualan di app, langsung di tabel Ringkasan
                              ini). SP+Voucher+Saldo saja (FWA ga ikut -
                              sesuai desain awal fitur upload). "–" kalau
                              memang belum ada upload sama sekali utk
                              periode bulan ini. */}
                          {sellinUploadAvailable ? (
                            <div style={{ textAlign: "right", fontWeight: 700, color: t.hi }}>Rp {fmtID(r.uploadSp + r.uploadVou + r.uploadSaldo)}</div>
                          ) : (
                            <div style={{ textAlign: "right", color: t.lo }}>–</div>
                          )}
                          {sellinUploadAvailable ? (() => {
                            const selisih = (r.nilaiSp + r.nilaiVoucher + r.nilaiSaldo) - (r.uploadSp + r.uploadVou + r.uploadSaldo);
                            return <div style={{ textAlign: "right", fontWeight: 700, color: selisih !== 0 ? t.red : t.mid }}>Rp {fmtID(selisih)}</div>;
                          })() : (
                            <div style={{ textAlign: "right", color: t.lo }}>–</div>
                          )}
                        </>
                      )}
                    </div>
                  ))}'''
do(old8, new8, label="row kolom baru")

assert src != orig, "no changes applied"
with open(path, "w", encoding="utf-8") as f:
    f.write(src)
print("OK - 8 edit berhasil (bagian 1/2: fetch+kolom leaderboard)")
